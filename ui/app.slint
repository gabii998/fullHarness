import { VerticalBox, HorizontalBox, ScrollView, ListView, LineEdit, TextEdit, ComboBox, Button, CheckBox, SpinBox } from "std-widgets.slint";

component HttpSegments inherits Rectangle {
    in property <[string]> labels;
    in-out property <int> current-index: 0;
    height: 32px; border-radius: 6px; background: #101822;
    border-width: 1px; border-color: #34435c;
    HorizontalBox {
        padding: 3px; spacing: 3px;
        for label[index] in root.labels : Rectangle {
            horizontal-stretch: 1; min-width: 72px; border-radius: 4px;
            background: root.current-index == index ? #354460 : transparent;
            accessible-role: button; accessible-label: label;
            Text { text: label; color: root.current-index == index ? #e3e7f3 : #91a0bc; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.current-index = index; } }
        }
    }
}

export struct SearchRow { path: string, line: int, text: string }
export struct BrowserStepRow { index: int, included: bool, title: string, detail: string }
export struct CaptureRow { index: int, name: string, detail: string }
export struct AttachmentRow { id: string, name: string, image: image }
export struct HttpRequestRow { id: string, title: string, method: string, selected: bool }
export struct UsageRow { title: string, metric: string, detail: string, hint: string, ratio: float }
export struct NavigationRow { id: string, title: string, project: bool, selected: bool, status: string }
export struct TaskRow { id: string, title: string, objective: string, acceptance: string, severity: int, status: int, tokens: string, chat: string, running: bool }
export struct ProjectChatRow { id: string, title: string, detail: string, status: string, running: bool }
export struct BuildCommandRow { command: string, purpose: string }
export struct TabRow { id: string, title: string, selected: bool }
export struct MarkdownCell { rendered: styled-text, alignment: int }
export struct MarkdownRow { header: bool, cells: [MarkdownCell] }
export struct MarkdownBlock { rendered: styled-text, rows: [MarkdownRow] }
export struct MessageRow { role: string, body: string, summary: string, blocks: [MarkdownBlock] }
export struct QuotaRow { caption: string, remaining: float }
export struct GitRow { path: string, target: string, status: string, staged: bool, unstaged: bool, header: bool, prepared: bool, name: string, directory: string, code: string, added: string, removed: string, stats: string }
export struct GitCommitRow { id: string, title: string, detail: string }
export struct LogcatRow { text: string, level: string }
export struct TerminalRun { text: string, column: int, columns: int, fg: color, bg: color, bold: bool }
export struct TerminalRow { runs: [TerminalRun] }
export struct ProblemRow { path: string, line: int, column: int, error: bool, code: string, message: string }
export struct DockerRow { id: string, name: string, detail: string, status: string, running: bool, paused: bool }
export struct DatabaseField { name: string, kind: string, tags: string, key: bool }
export struct DatabaseEntity { name: string, detail: string, x: float, y: float, height: float, fields: [DatabaseField] }
export struct DatabaseRelation { x1: float, y1: float, mid: float, x2: float, y2: float, label: string, detail: string }

export struct PreviewLine { text: string, kind: int }
export struct FileRow { path: string, name: string, directory: bool, expanded: bool, depth: int }
export struct FileTabRow { project: string, path: string, title: string, text: string, status: string }

component FileViewer inherits Rectangle {
    vertical-stretch: 1;
    min-height: 0px;
    in property <[PreviewLine]> lines;
    in property <int> columns;
    in property <int> target-line: 0;
    callback locate();
    callback row-created();
    private property <bool> locate-pending: false;
    // ListView computes its virtual content size after the model/layout changes.
    // Defer the jump until then, and consume it once so manual scrolling stays free.
    locate => { root.locate-pending = true; }
    init => { root.locate(); }
    Timer {
        interval: 1ms;
        running: root.locate-pending && file-scroll.visible-height > 0px
            && file-scroll.content-height >= root.lines.length * 20px;
        triggered => {
            file-scroll.content-y = min(0px, max(file-scroll.visible-height - file-scroll.content-height, -(max(0, root.target-line - 3)) * 20px));
            root.locate-pending = false;
        }
    }
    changed target-line => { root.locate(); }
    changed lines => { file-scroll.content-y = 0px; file-scroll.content-x = 0px; root.locate(); }
    background: #1c2836; border-radius: 4px;
    file-scroll := ListView {
        x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
        content-width: max(self.visible-width, 60px + root.columns * 7.5px);
        // Let Slint recycle only the rows that enter the viewport.
        for line[index] in root.lines : Rectangle {
            init => { root.row-created(); }
            height: 20px; width: file-scroll.content-width;
            background: root.target-line == index + 1 ? #36334e : line.kind == 1 ? #203c31 : line.kind == 2 ? #442b34 : line.kind == 3 ? #2b2b48 : transparent;
            Text { x: 0px; width: 44px; height: 20px; text: index + 1; color: #8291ad; font-family: "Consolas"; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
            TextInput { x: 54px; width: parent.width - 54px; height: 20px; text: line.text; color: line.kind == 1 ? #9cddb3 : line.kind == 2 ? #f1aaaa : line.kind == 3 ? #bbb2ff : #e3e7f3; font-family: "Consolas"; font-size: 12px; read-only: true; wrap: no-wrap; vertical-alignment: center; }
        }
    }
}

component TaskColumn inherits Rectangle {
    in property <string> title;
    in property <color> accent;
    in property <[TaskRow]> tasks;
    callback edit(string);
    callback open-chat(string);
    background: #121d29; border-radius: 8px; border-width: 1px; border-color: #2b384e;
    VerticalBox {
        padding: 10px; spacing: 10px;
        HorizontalBox {
            padding: 0px; spacing: 6px; height: 24px;
            Rectangle { width: 6px; height: 6px; background: root.accent; border-radius: 3px; }
            Text { text: root.title; color: #e3e7f3; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
            Text { text: root.tasks.length; color: #8291ad; font-size: 12px; vertical-alignment: center; }
        }
        if root.tasks.length == 0 : Text { text: "Sin tareas"; color: #8291ad; font-size: 12px; height: 28px; }
        ListView {
            horizontal-scrollbar-policy: always-off;
            for task in root.tasks : Rectangle {
                height: 254px;
                Rectangle {
                    height: parent.height - 6px; width: parent.width;
                    background: #1b2737; border-radius: 7px; border-width: 1px; border-color: #34435c;
                    VerticalBox {
                        padding: 10px; spacing: 6px;
                        HorizontalBox {
                            padding: 0px; spacing: 8px; height: 36px;
                            Text { text: task.title; color: #eee8ff; font-size: 13px; font-weight: 600; wrap: word-wrap; overflow: elide; min-width: 0px; horizontal-stretch: 1; }
                            Rectangle {
                                private property <color> severity-color: task.severity == 3 ? #ed9696 : task.severity == 2 ? #dcb27c : task.severity == 1 ? #b7afff : #78c99b;
                                width: 52px; height: 22px; border-radius: 5px;
                                background: self.severity-color.with-alpha(0.12); border-width: 1px; border-color: self.severity-color.with-alpha(0.35);
                                Text { text: ["Baja", "Media", "Alta", "Crítica"][task.severity]; color: parent.severity-color; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        Text { text: "Objetivo"; color: #8291ad; font-size: 10px; height: 14px; }
                        Text { text: task.objective; color: #c8cde0; font-size: 11px; wrap: word-wrap; overflow: elide; height: 28px; }
                        Text { text: "Criterio de aceptación"; color: #8291ad; font-size: 10px; height: 14px; }
                        Text { text: task.acceptance; color: #c8cde0; font-size: 11px; wrap: word-wrap; overflow: elide; height: 28px; }
                        Text { text: task.tokens; color: #91a0bc; font-size: 10px; height: 18px; overflow: elide; }
                        HorizontalBox {
                            padding: 0px; spacing: 6px; height: 32px;
                            Rectangle { horizontal-stretch: 1; }
                            if task.chat != "" : Button { text: "Chat"; icon: @image-url("assets/chat.svg"); width: 68px; clicked => { root.open-chat(task.chat); } }
                            Button { text: "Editar"; width: 58px; enabled: !task.running; clicked => { root.edit(task.id); } }
                        }
                    }
                }
            }
        }
    }
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    in property <string> label;
    callback clicked();
    width: 28px; height: 28px;
    Button {
        width: parent.width; height: parent.height;
        enabled: root.enabled;
        accessible-label: root.label;
        clicked => { root.clicked(); }
    }
    Image {
        source: root.icon;
        width: 16px; height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.enabled ? 1 : 0.4;
    }
}

component GitSelectionCheckbox inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled();
    width: 24px; height: 24px;
    forward-focus: checkbox-focus;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-label: root.label;
    accessible-action-default => { if root.enabled { root.toggled(); } }
    Rectangle {
        x: 3px; y: 3px; width: 18px; height: 18px; border-radius: 3px;
        border-width: 1px; border-color: root.checked || checkbox-touch.has-hover ? #9182ff : #59667d;
        background: root.checked ? #6557ce : checkbox-touch.has-hover ? #29374b : #192534;
        opacity: root.enabled ? 1 : 0.5;
        if root.checked : Image { x: 2px; y: 2px; width: 14px; height: 14px; source: @image-url("assets/check.svg"); }
    }
    checkbox-touch := TouchArea { enabled: root.enabled; clicked => { checkbox-focus.focus(); root.toggled(); } }
    checkbox-focus := FocusScope {
        x: 0px; width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return { root.toggled(); return accept; }
            return reject;
        }
    }
    if checkbox-focus.has-focus && root.enabled : Rectangle { border-width: 1px; border-color: #9182ff; border-radius: 4px; }
}

component ChatMessage inherits Rectangle {
    in property <MessageRow> message;
    private property <bool> from-user: message.role == "Vos";
    private property <bool> tool: message.role.starts-with("Herramienta");
    private property <bool> tool-expanded: false;
    private property <float> tool-expansion: root.tool-expanded ? 1 : 0;
    animate tool-expansion { duration: 160ms; easing: ease-out; }
    private property <bool> structured: message.blocks.length > 1 || (message.blocks.length == 1 && message.blocks[0].rows.length > 0);
    in property <bool> in-viewport: true;
    // Keep a bounded neighborhood instantiated, independently of what is painted.
    in property <bool> in-cache: true;
    private property <bool> bubble-active: root.in-viewport;
    callback visibility-changed(bool);
    callback measure-requested();
    in property <int> measurement-epoch;
    in property <bool> defer-measurement: false;
    init => { root.visibility-changed(root.bubble-active); }
    changed bubble-active => { root.visibility-changed(root.bubble-active); }
    changed message => { root.tool-expanded = false; root.visibility-changed(root.bubble-active); }
    // Geometry comes from one persistent content tree, not height-change callbacks.
    height: root.message.body == "" ? 0px : root.tool ? 36px + root.tool-expansion * (max(36px, message-card.height) - 36px) : message-card.height + (root.from-user ? 9px : 0px);
    clip: root.tool;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    if root.tool : Rectangle {
        opacity: 1 - root.tool-expansion;
        visible: root.in-viewport;
        x: 0px; y: 0px; width: min(parent.width, 780px); height: 32px;
        background: #15212c; border-radius: 6px; border-width: 1px; border-color: #2b3a4a;
        Image { x: 10px; y: 8px; width: 16px; height: 16px; source: @image-url("assets/wrench.svg"); }
        Text { x: 34px; y: 0px; width: parent.width - 64px; height: 32px; text: root.message.summary; color: #99aabd; font-size: 12px; overflow: elide; wrap: no-wrap; vertical-alignment: center; }
        Image { x: parent.width - 24px; y: 10px; width: 12px; height: 12px; source: @image-url("assets/chevron-down.svg"); }
        TouchArea { enabled: !root.tool-expanded; clicked => { root.tool-expanded = true; } }
    }
    message-card := Rectangle {
        opacity: root.tool ? root.tool-expansion : 1;
        visible: root.bubble-active && root.message.body != "" && (!root.tool || root.tool-expansion > 0);
        width: min(parent.width, root.from-user ? 640px : 780px);
        x: root.from-user ? parent.width - self.width : 0px;
        height: (root.tool ? 38px : 14px) + (root.structured ? rich-body.height : body.height) + 14px;
        background: root.from-user ? #292d50 : root.tool ? #15212c : transparent;
        border-radius: root.from-user || root.tool ? 10px : 0px;
        border-width: root.tool ? 1px : 0px;
        border-color: #2b3a4a;
        if root.tool : Text {
            x: 14px; y: 12px; width: parent.width - 28px; height: 18px;
            text: "Detalles de la llamada";
            color: root.from-user ? #b7afff : root.tool ? #93a6ba : #9992ff;
            font-size: 12px; font-weight: 600; overflow: elide;
        }
        if root.from-user : Image {
            x: parent.width - 26px; y: parent.height - 1px;
            width: 14px; height: 10px;
            source: @image-url("assets/chat-tail.svg");
        }
        if root.tool : IconButton { x: parent.width - 42px; y: 6px; icon: @image-url("assets/chevron-down.svg"); label: "Contraer llamada de herramienta"; clicked => { root.tool-expanded = false; } }
        body := StyledText {
            x: 14px; y: root.tool ? 38px : 14px; width: parent.width - 28px;
            height: root.structured ? 0px : self.preferred-height;
            visible: !root.structured;
            text: root.message.blocks[0].rendered;
            default-color: root.tool ? #99aabd : #e3e7f3;
            default-font-size: root.tool ? 12px : 14px;
            link-color: #b4adff;
        }
        rich-body := VerticalLayout {
            x: 14px; y: root.tool ? 38px : 14px; width: parent.width - 28px;
            height: self.preferred-height;
            spacing: 12px;
            for block in (root.structured ? root.message.blocks : []) : VerticalLayout {
                width: parent.width;
                height: self.preferred-height;
                spacing: 0px;
                if block.rows.length == 0 : StyledText {
                    width: parent.width;
                    height: self.preferred-height;
                    text: block.rendered;
                    default-color: root.tool ? #99aabd : #e3e7f3;
                    default-font-size: root.tool ? 12px : 14px;
                    link-color: #b4adff;
                }
                for row[index] in block.rows : HorizontalLayout {
                    width: parent.width;
                    height: self.preferred-height;
                    spacing: 0px;
                    for cell in row.cells : Rectangle {
                        width: parent.width / row.cells.length;
                        horizontal-stretch: 1;
                        min-height: cell-text.preferred-height + 16px;
                        background: row.header ? #293548 : mod(index, 2) == 0 ? #192532 : #202c3b;
                        border-width: 1px; border-color: #354254;
                        cell-text := StyledText {
                            x: 8px; y: 8px; width: parent.width - 16px;
                            height: self.preferred-height;
                            text: cell.rendered;
                            horizontal-alignment: cell.alignment == 1 ? center : cell.alignment == 2 ? right : left;
                            default-color: #e3e7f3; default-font-size: 13px; link-color: #b4adff;
                        }
                    }
                }
            }
        }
    }
}

component AgentConfig inherits Rectangle {
    in property <string> name;
    in property <bool> direct: false;
    in property <bool> pending: false;
    in property <bool> connected: false;
    in property <[string]> models;
    in-out property <int> model-index: 0;
    in-out property <bool> enabled;
    in-out property <string> executable;
    in-out property <string> model;
    in-out property <int> concurrency: 1;
    in-out property <int> effort-index: 0;
    in property <string> status;
    in property <bool> busy;
    callback detect();
    callback browse();
    callback check();
    callback login();
    callback path-edited();
    callback pick-model(int);
    callback disconnect();
    background: #1e2a39;
    border-radius: 9px;
    VerticalBox {
        padding: 16px;
        spacing: 8px;
        HorizontalBox {
            padding: 0px;
            Text { text: root.name; color: #e3e7f3; font-size: 19px; font-weight: 600; }
            Rectangle { horizontal-stretch: 1; }
            if !root.pending : CheckBox { text: "Habilitado"; checked <=> root.enabled; enabled: !root.busy; }
        }
        if !root.direct && !root.pending : HorizontalBox {
            padding: 0px;
            spacing: 8px;
            LineEdit { text <=> root.executable; placeholder-text: "Ruta del cliente oficial"; enabled: !root.busy; horizontal-stretch: 1; edited => { root.path-edited(); } }
            Button { text: "Detectar"; enabled: !root.busy; clicked => { root.detect(); } }
            Button { text: "Buscar…"; enabled: !root.busy; clicked => { root.browse(); } }
        }
        if root.direct : Text { text: "Conexión directa con tu plan ChatGPT · Sin instalar Codex"; color: #a6b4cb; wrap: word-wrap; font-size: 12px; }
        if root.direct && root.models.length > 0 : ComboBox { model: root.models; current-index <=> root.model-index; enabled: !root.busy; selected => { root.pick-model(self.current-index); } }
        if !root.pending : HorizontalBox {
            padding: 0px;
            spacing: 8px;
            LineEdit { text <=> root.model; placeholder-text: root.direct ? "Modelo: elegí uno del catálogo de tu cuenta" : "Modelo: predeterminado del cliente"; enabled: !root.busy; horizontal-stretch: 1; }
            Text { text: "Concurrencia"; color: #a6b4cb; }
            SpinBox { value <=> root.concurrency; minimum: 1; maximum: 4; enabled: !root.busy; width: 90px; }
        }
        Text { text: root.status; color: #a6b4cb; wrap: word-wrap; font-size: 12px; }
        if !root.pending : HorizontalBox {
            padding: 0px;
            spacing: 8px;
            Button { text: root.direct ? "Actualizar modelos" : "Verificar cliente"; enabled: !root.busy && (root.direct || root.executable != ""); clicked => { root.check(); } }
            Button { text: root.direct ? (root.connected ? "Volver a autorizar" : "Continue with ChatGPT") : "Iniciar sesión"; enabled: !root.busy && (root.direct || root.executable != ""); clicked => { root.login(); } }
            if root.direct : Button { text: "Desconectar"; enabled: !root.busy; clicked => { root.disconnect(); } }
            Rectangle { horizontal-stretch: 1; }
            Text { text: "Modalidad: suscripción"; color: #9591ff; font-size: 12px; }
        }
    }
}

component PanelSelect inherits Rectangle {
    in property <int> active-index;
    in property <bool> enabled: true;
    callback selected(int);
    private property <[string]> labels: ["Sin panel", "Git", "Archivos", "Terminal", "Problemas", "Docker", "Base de datos", "Logcat", "HTTP", "Imágenes", "Buscar", "Ejecución", "Navegador / Flujos"];
    private property <[image]> icons: [@image-url("assets/workspace.svg"), @image-url("assets/git.svg"), @image-url("assets/folder.svg"), @image-url("assets/terminal.svg"), @image-url("assets/problems.svg"), @image-url("assets/docker.svg"), @image-url("assets/database.svg"), @image-url("assets/logcat.svg"), @image-url("assets/http.svg"), @image-url("assets/captures.svg"), @image-url("assets/folder.svg"), @image-url("assets/play.svg"), @image-url("assets/http.svg")];
    Button {
        width: parent.width; height: parent.height;
        enabled: root.enabled; accessible-label: "Panel lateral: " + root.labels[root.active-index];
        clicked => { options.show(); }
    }
    Image { x: 12px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; source: root.icons[root.active-index]; opacity: root.enabled ? 1 : 0.4; }
    Text { x: 36px; width: parent.width - 66px; height: parent.height; text: root.labels[root.active-index]; color: root.enabled ? #e3e7f3 : #68738b; font-size: 12px; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
    Image { x: parent.width - 22px; y: (parent.height - 12px) / 2; width: 12px; height: 12px; source: @image-url("assets/chevron-down.svg"); opacity: root.enabled ? 1 : 0.4; }
    options := PopupWindow {
        x: 0px; y: root.height + 4px; width: root.width; height: root.labels.length * 36px + 16px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: #192534; border-radius: 8px; border-width: 1px; border-color: #384561;
            VerticalBox {
                padding: 8px; spacing: 4px;
                for label[index] in root.labels : Rectangle {
                    height: 32px;
                    Button {
                        width: parent.width; height: parent.height;
                        accessible-label: label + (index == root.active-index ? ", seleccionado" : "");
                        clicked => { root.selected(index); options.close(); }
                    }
                    Image { x: 10px; y: 8px; width: 16px; height: 16px; source: root.icons[index]; }
                    Text { x: 34px; width: parent.width - 44px; height: parent.height; text: label; color: #e3e7f3; font-size: 12px; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                }
            }
        }
    }
}

component ChatTouch inherits TouchArea {
    in property <bool> chat: true;
    callback open();
    callback close-tab();
    callback delete-chat();
    private property <length> menu-x;
    private property <length> menu-y;
    clicked => { root.open(); }
    pointer-event(event) => {
        if root.chat && event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
            root.menu-x = self.mouse-x;
            root.menu-y = self.mouse-y;
            menu.show();
        }
    }
    menu := PopupWindow {
        x: root.menu-x; y: root.menu-y; width: 200px; height: 128px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: #192534; border-radius: 8px; border-width: 1px; border-color: #384561;
            VerticalBox {
                padding: 8px; spacing: 4px;
                Button { text: "Abrir chat"; clicked => { menu.close(); root.open(); } }
                Button { text: "Cerrar pestaña"; clicked => { menu.close(); root.close-tab(); } }
                Button { text: "Eliminar chat…"; clicked => { menu.close(); root.delete-chat(); } }
            }
        }
    }
}
component SidebarItem inherits Rectangle {
    in property <NavigationRow> item;
    in property <bool> compact: false;
    callback clicked();
    callback hovered(string, length);
    callback close-tab();
    callback delete-chat();
    accessible-role: button;
    accessible-label: item.title;
    accessible-action-default => { root.clicked(); }
    height: item.project ? 42px : 36px;
    border-radius: 7px;
    background: item.selected ? #30316b : touch.has-hover ? #1e2a3b : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    if !root.compact : HorizontalBox {
        padding-left: item.project ? 12px : 28px;
        padding-right: 12px;
        Image { source: item.project ? @image-url("assets/folder.svg") : @image-url("assets/chat.svg"); width: 18px; height: 18px; }
        Text { text: item.title; color: #e3e7f3; font-size: 13px; overflow: elide; font-weight: item.project ? 600 : 400; }
        if !item.project : Rectangle { width: 7px; height: 7px; border-radius: 4px; background: item.status == "running" ? #46cb7c : #7b8bab; }
    }
    if root.compact : Rectangle {
        Image { x: (parent.width - 18px) / 2; y: 5px; width: 18px; height: 18px; source: item.project ? @image-url("assets/folder.svg") : @image-url("assets/chat.svg"); }
        Text { y: 24px; width: parent.width; height: 14px; text: item.title; font-size: 9px; color: #c0cbe0; horizontal-alignment: center; overflow: elide; }
        if !item.project : Rectangle { x: parent.width - 9px; y: 5px; width: 6px; height: 6px; border-radius: 3px; background: item.status == "running" ? #46cb7c : #7b8bab; }
    }
    touch := ChatTouch {
        chat: !root.item.project;
        open => { root.clicked(); }
        close-tab => { root.close-tab(); }
        delete-chat => { root.delete-chat(); }
        changed has-hover => { if root.compact { root.hovered(self.has-hover ? root.item.title : "", root.absolute-position.y); } }
    }
}

