    in property <bool> http-ready: false;
    in property <string> http-loaded-project;
    in-out property <string> http-notice;
    in-out property <[string]> http-collections;
    in-out property <int> http-collection-index: 0;
    in-out property <string> http-collection-name;
    in-out property <bool> http-exposed: false;
    in property <[HttpRequestRow]> http-requests;
    in property <[string]> http-request-names;
    in property <int> http-request-index;
    in property <string> http-request-id;
    in-out property <string> http-request-name;
    in-out property <bool> http-rename-open: false;
    private property <bool> http-rename-collection: false;
    in-out property <string> http-rename-name;
    in-out property <int> http-method-index: 0;
    in-out property <string> http-url;
    in-out property <string> http-headers;
    in-out property <string> http-body;
    in property <int> http-saved-method-index;
    in property <string> http-saved-url;
    in property <string> http-saved-headers;
    in property <string> http-saved-body;
    in property <bool> http-saved-exposed;
    private property <bool> http-dirty: root.http-method-index != root.http-saved-method-index || root.http-url != root.http-saved-url || root.http-headers != root.http-saved-headers || root.http-body != root.http-saved-body || root.http-exposed != root.http-saved-exposed;
    in-out property <int> http-timeout: 30;
    in-out property <int> http-request-view: 0;
    in-out property <int> http-response-view: 0;
    in property <[PreviewLine]> http-response-lines;
    in property <int> http-response-columns;
    in property <string> http-response-status;
    in-out property <bool> http-variables-open: false;
    in-out property <string> http-variables-json;
    callback open-http(); callback load-http(); callback http-action(string);
    callback pick-http-collection(int); callback pick-http-request(string);
    callback send-http(); callback cancel-http(); callback show-http-response(); callback open-http-results();
    changed http-response-view => { root.show-http-response(); }
    open-http => { root.http-open = true; }
    changed http-open => {
        if root.http-open { root.execution-open = false; root.flows-open = false;
            root.captures-open = false; root.search-open = false; root.git-open = false; root.files-open = false; root.logcat-open = false; root.database-open = false; root.docker-open = false; root.lint-open = false; root.terminal-open = false;
            if root.http-loaded-project != root.git-project { root.load-http(); }
        }
        root.update-workspace-layout();
    }
    in-out property <bool> usage-open: false;
    in-out property <bool> usage-tab-open: false;
    callback open-usage();
    open-usage => { root.usage-tab-open = true; root.file-preview-open = false; root.usage-open = true; root.refresh-usage(); }
    in property <bool> usage-busy: false;
    in property <string> usage-status;
    in property <string> usage-totals;
    in-out property <int> usage-scope: 0;
    in-out property <int> usage-view: 0;
    in property <string> usage-selected-chat;
    in property <[UsageRow]> usage-rows;
    callback refresh-usage(); callback show-usage(); callback open-usage-report();
    changed usage-scope => { if root.usage-open { root.refresh-usage(); } }
    changed usage-view => { root.show-usage(); }
    changed usage-selected-chat => { if root.usage-open && root.usage-scope == 1 { root.refresh-usage(); } if root.captures-open { root.refresh-captures(); } }

    in-out property <bool> execution-open: false;
    in-out property <bool> execution-config-open: false;
    in-out property <bool> execution-android-open: false;
    in property <bool> execution-busy: false;
    in property <[string]> execution-names;
    in-out property <int> execution-index: 0;
    in property <[string]> execution-run-names;
    in property <[string]> execution-run-ids;
    in-out property <int> execution-run-index: 0;
    in-out property <bool> execution-stderr: false;
    in property <string> execution-output;
    in property <string> execution-message;
    in-out property <string> execution-config-json;
    in-out property <string> execution-android-module: "app";
    in-out property <string> execution-android-variant: "Debug";
    in-out property <string> execution-android-device;
    in-out property <string> execution-android-component;
    callback load-execution(); callback save-execution(); callback detect-execution();
    in-out property <[string]> execution-device-names;
    in-out property <[string]> execution-device-ids;
    in-out property <int> execution-device-index: 0;
    callback execution-devices(); callback choose-execution-device();
    callback save-android-execution(); callback execution-action(string);
    changed execution-open => {
        if root.execution-open { root.flows-open = false;
            root.git-open = false; root.files-open = false; root.terminal-open = false;
            root.lint-open = false; root.docker-open = false; root.database-open = false;
            root.logcat-open = false; root.http-open = false; root.captures-open = false; root.search-open = false;
            root.load-execution();
        }
        root.update-workspace-layout();
    }
    in-out property <bool> terminal-open: false;
    private property <float> terminal-progress: root.terminal-open ? 1 : 0;
    in property <bool> terminal-busy: false;
    in property <bool> terminal-running: false;
    in-out property <int> terminal-shell-index: 0;
    in property <string> terminal-status;
    in property <[TerminalRow]> terminal-rows;
    in property <int> terminal-cursor-row: 0;
    in property <int> terminal-cursor-column: 0;
    in property <bool> terminal-cursor-visible: false;
    out property <int> terminal-width-columns: max(20, floor((root.panel-width - 36px) / 7.2px));
    out property <int> terminal-height-rows: max(4, floor((root.height - 206px) / 18px));
    callback start-terminal(); callback close-terminal(); callback refresh-terminal();
    callback terminal-key(string, bool, bool, bool); callback terminal-scroll(int);
    changed terminal-open => {
        if root.terminal-open { root.execution-open = false; root.flows-open = false; root.http-open = false; root.captures-open = false; root.search-open = false; root.git-open = false; root.files-open = false; root.logcat-open = false; root.database-open = false; root.docker-open = false; root.lint-open = false; }
        root.refresh-terminal(); root.update-workspace-layout();
    }
    in property <bool> explorer-busy: false;
    in-out property <[FileRow]> explorer-rows;
    in property <string> explorer-status: "Abrí un proyecto para explorar sus archivos.";
    in-out property <bool> file-preview-open: false;
    changed file-preview-open => { if root.file-preview-open { root.usage-open = false; } }
    in-out property <[FileTabRow]> file-tabs;
    in-out property <string> file-preview-project;
    in-out property <string> file-preview-path;
    in-out property <string> file-preview-text;
    in-out property <string> file-preview-status;
    in property <[PreviewLine]> file-preview-lines;
    in property <int> file-preview-columns;
    in property <string> file-preview-location;
    callback select-file-tab(string, string);
    callback close-file-tab(string, string);
    callback activate-file-project(string);
    callback refresh-explorer(bool);
    callback select-file(string);
    callback explorer-event(string);
    callback open-project-folder();
    changed files-open => { if root.files-open { root.execution-open = false; root.flows-open = false; root.git-open = false; root.logcat-open = false; root.database-open = false; root.docker-open = false; root.lint-open = false; root.terminal-open = false; root.http-open = false; root.captures-open = false; root.search-open = false; root.refresh-explorer(false); } root.update-workspace-layout(); }

    in-out property <bool> logcat-open: false;
    private property <float> logcat-progress: root.logcat-open ? 1 : 0;
    changed logcat-open => {
        if root.logcat-open { root.execution-open = false; root.flows-open = false; root.git-open = false; root.files-open = false; root.database-open = false; root.docker-open = false; root.lint-open = false; root.terminal-open = false; root.http-open = false; root.captures-open = false; root.search-open = false; root.refresh-logcat-devices(); }
        else { root.stop-logcat(); }
        root.update-workspace-layout();
    }
    in property <[string]> logcat-devices;
    in-out property <int> logcat-device-index: 0;
    in property <bool> logcat-device-ready: false;
    in property <bool> logcat-busy: false;
    in property <bool> logcat-running: false;
    in property <string> logcat-error;
    in property <string> logcat-status: "Seleccioná un dispositivo para ver sus logs.";
    in property <[LogcatRow]> logcat-lines;
    in property <int> logcat-columns: 40;
    in-out property <string> logcat-filter;
    in-out property <int> logcat-level: 2;
    in-out property <bool> logcat-follow: true;
    callback refresh-logcat-devices();
    callback select-logcat-device(int);
    callback start-logcat();
    callback stop-logcat();
    callback clear-logcat();
    callback filter-logcat();

    // Paint the complete client area independently of the content layout.
    Rectangle {
        width: root.width;
        height: root.height;
        background: #101822;
    }

    VerticalBox {
        width: root.width;
        height: root.height;
        padding: 14px;
        spacing: 12px;
        HorizontalBox {
            height: 32px;
            padding: 0px;
            Rectangle {
                horizontal-stretch: 1; min-width: 200px;
                HorizontalBox {
                    padding: 0px; spacing: 8px;
                    Image { source: @image-url("assets/logo.svg"); width: 28px; height: 28px; }
                    Text { text: "Ascurra Harness"; color: #f0f2fa; font-size: 19px; font-weight: 600; height: 32px; vertical-alignment: center; }
                    Text { text: root.has-project ? root.title-project-path : "MVP 0.1"; height: 32px; vertical-alignment: center; color: #91a0bc; font-size: 12px; overflow: elide; min-width: 0px; horizontal-stretch: 1; }
                }
                TouchArea {
                    pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.window-drag(); } }
                    double-clicked => { root.window-maximize(); }
                }
            }
            Button { text: "Uso"; icon: @image-url("assets/usage.svg"); enabled: root.has-project; clicked => { root.open-usage(); } }
            Button { text: "Configuración"; icon: @image-url("assets/settings.svg"); clicked => { root.open-settings(); } }
            PanelSelect {
                width: 190px; height: 32px;
                active-index: root.active-panel-index;
                enabled: root.has-project;
                selected(index) => { root.select-panel(index); }
            }
            Button { text: "−"; accessible-label: "Minimizar ventana"; width: 36px; height: 32px; clicked => { root.window-minimize(); } }
            Button { text: root.window-maximized ? "❐" : "□"; accessible-label: root.window-maximized ? "Restaurar ventana" : "Maximizar ventana"; width: 36px; height: 32px; clicked => { root.window-maximize(); } }
            Button { text: "×"; accessible-label: "Cerrar ventana"; width: 36px; height: 32px; clicked => { root.window-close(); } }
        }
        HorizontalBox {
            spacing: 12px;
            padding: 0px;
            padding-right: root.sidebar-reservation;
            VerticalBox {
                width: root.projects-width; padding: 0px; spacing: 8px;
            projects-panel := Rectangle {
                width: root.projects-width;
                vertical-stretch: 1;
                background: #121d29;
                border-color: #27354a;
                border-width: 1px;
                border-radius: 10px;
                VerticalBox {
                    padding: root.projects-compact ? 8px : 12px;
                    spacing: 8px;
                    if !root.projects-compact : HorizontalBox {
                        height: 28px; padding: 0px; spacing: 6px;
                        Text { text: "PROYECTOS Y CHATS"; color: #8291ad; font-size: 10px; horizontal-stretch: 1; min-width: 0px; overflow: elide; vertical-alignment: center; }
                        Button { text: "Abrir"; icon: @image-url("assets/folder.svg"); accessible-label: "Abrir proyecto"; width: 84px; height: 28px; clicked => { root.project-dialog = true; } }
                        IconButton { width: 28px; height: 28px; icon: @image-url("assets/chevron-left.svg"); label: "Compactar proyectos y chats"; clicked => { root.projects-compact = true; } }
                    }
                    if root.projects-compact : VerticalBox {
                        height: 68px; padding: 0px; spacing: 8px; alignment: center;
                        IconButton { width: 40px; height: 28px; icon: @image-url("assets/chevron-right.svg"); label: "Expandir proyectos y chats"; clicked => { root.projects-compact = false; } }
                        IconButton { width: 40px; height: 32px; icon: @image-url("assets/folder.svg"); label: "Abrir proyecto"; clicked => { root.project-dialog = true; } }
                    }
                    ScrollView {
                        content-width: self.visible-width;
                        horizontal-scrollbar-policy: always-off;
                        VerticalBox {
                            spacing: 3px;
                            for item in root.navigation : SidebarItem {
                                item: item; compact: root.projects-compact;
                                height: root.projects-compact ? 44px : item.project ? 42px : 36px;
                                clicked => { root.projects-hover-title = ""; root.select-row(item.id); }
                                close-tab => { root.close-tab(item.id); }
                                delete-chat => { root.delete-chat(item.id); }
                                hovered(title, y) => { root.projects-hover-title = title; root.projects-hover-y = y; }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                }
            }
                    if root.projects-compact : Rectangle {
                        height: 28px + root.quota-card-rows * 10px; background: #172332; border-radius: 8px;
                        VerticalBox {
                            padding: 6px; spacing: 5px;
                            Text { height: 16px; text: root.quota-provider == 0 ? "Codex" : "Claude"; font-size: 10px; color: #c2cde0; horizontal-alignment: center; }
                            for window in root.shown-quota-windows : Rectangle {
                                height: 5px; border-radius: 3px; background: #2b394d;
                                Rectangle { width: parent.width * window.remaining / 100; height: parent.height; background: window.remaining <= 15 ? #e3aa63 : #8e86ff; border-radius: 3px; }
                            }
                        }
                        TouchArea { clicked => { if root.codex-authenticated && root.claude-authenticated { root.quota-provider = 1 - root.quota-provider; } } }
                    }
                    if !root.projects-compact : Rectangle {
                        height: 81px + root.quota-card-rows * 45px;
                        background: #172332; border-radius: 8px;
                        VerticalBox {
                            padding: 10px; spacing: 5px;
                            HorizontalBox {
                                padding: 0px;
                                spacing: 6px; height: 28px;
                                IconButton {
                                    icon: @image-url("assets/chevron-left.svg"); width: 28px; height: 28px;
                                    label: "Proveedor anterior";
                                    enabled: root.codex-authenticated && root.claude-authenticated;
                                    clicked => { root.quota-provider = root.quota-provider == 0 ? 1 : 0; }
                                }
                                Text { text: root.quota-provider == 0 ? "Codex" : "Claude"; color: #e3e7f3; font-size: 12px; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; horizontal-stretch: 1; }
                                IconButton {
                                    icon: @image-url("assets/quota-chevron-right.svg"); width: 28px; height: 28px;
                                    label: "Proveedor siguiente";
                                    enabled: root.codex-authenticated && root.claude-authenticated;
                                    clicked => { root.quota-provider = root.quota-provider == 0 ? 1 : 0; }
                                }
                            }
                            if root.quota-card-rows > 0 : Rectangle {
                                height: root.quota-card-rows * 45px - 5px;
                                VerticalBox {
                                    padding: 0px; spacing: 5px; alignment: start;
                                    for window in root.shown-quota-windows : Rectangle {
                                        height: 40px; vertical-stretch: 0;
                                        Text { width: parent.width; height: 25px; text: window.caption; color: #c2cde0; font-size: 10px; wrap: word-wrap; }
                                        Rectangle {
                                            y: 30px; width: parent.width; height: 5px; border-radius: 3px; background: #2b394d;
                                            Rectangle { x: 0px; y: 0px; width: parent.width * window.remaining / 100; height: parent.height; border-radius: 3px; background: window.remaining <= 15 ? #e3aa63 : #8e86ff; animate width { duration: 180ms; easing: ease-out; } }
                                        }
                                    }
                                }
                            }
                            HorizontalBox {
                                padding: 0px; spacing: 6px; height: 28px; alignment: start;
                                if root.shown-quota-busy : Rectangle {
                                    width: 14px; height: 28px;
                                    Image {
                                        y: (parent.height - self.height) / 2;
                                        width: 14px; height: 14px;
                                        source: @image-url("assets/quota-spinner.svg");
                                        transform-origin: { x: self.width / 2, y: self.height / 2 };
                                        transform-rotation: 360deg * mod(animation-tick(), 900ms) / 900ms;
                                        accessible-role: progress-indicator;
                                        accessible-label: "Sincronizando cuota";
                                    }
                                }
                                Text { text: root.shown-quota-busy ? "Sincronizando…" : (root.quota-provider == 0 ? root.quota-status : root.claude-quota-status); color: #8e9fba; font-size: 10px; height: 28px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; overflow: elide; }
                            }
                        }
                    }
                    if !root.projects-compact && root.codex-authenticated && root.claude-authenticated : Rectangle {
                        height: 18px;
                        private property <int> provider-count: (root.codex-authenticated ? 1 : 0) + (root.claude-authenticated ? 1 : 0);
                        HorizontalBox {
                            x: (parent.width - parent.provider-count * 16px) / 2;
                            width: parent.provider-count * 16px; height: 18px; padding: 0px; spacing: 0px;
                            if root.codex-authenticated : Rectangle {
                                width: 16px; height: 18px;
                                Rectangle { x: 4px; y: 5px; width: 8px; height: 8px; border-radius: 4px; background: root.quota-provider == 0 ? #a398ff : #39485e; animate background { duration: 120ms; } }
                            }
                            if root.claude-authenticated : Rectangle {
                                width: 16px; height: 18px;
                                Rectangle { x: 4px; y: 5px; width: 8px; height: 8px; border-radius: 4px; background: root.quota-provider == 1 ? #a398ff : #39485e; animate background { duration: 120ms; } }
                            }
                        }
                    }
            }
            work-area := VerticalBox {
                min-width: 0px;
                spacing: 8px;
                padding: 0px;
                HorizontalBox {
                    height: 40px;
                    spacing: 4px;
                    padding: 0px;
                    IconButton {
                        width: 40px; height: 40px;
                        icon: @image-url("assets/plus.svg"); label: "Nuevo chat";
                        enabled: root.has-project;
                        clicked => { root.usage-open = false; root.new-chat(); }
                    }
                    tab-scroll := ScrollView {
                        height: 40px; horizontal-stretch: 1; min-width: 0px;
                        private property <int> tab-count: root.tabs.length + root.file-tabs.length + (root.usage-tab-open ? 1 : 0);
                        private property <length> item-width: clamp((self.visible-width - max(0, self.tab-count - 1) * 4px) / max(1, self.tab-count), 96px, 190px);
                        horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: always-off;
                        content-height: 40px;
                        content-width: max(self.visible-width, self.tab-count * self.item-width + max(0, self.tab-count - 1) * 4px);
                        HorizontalBox {
                            width: tab-scroll.content-width; height: 40px;
                            padding: 0px; spacing: 4px; alignment: start;
                            for tab in root.tabs : Rectangle {
                                width: tab-scroll.item-width;
                                border-radius: 7px;
                                background: tab.selected && !root.file-preview-open && !root.usage-open ? #30316b : #192333;
                                border-width: 1px;
                                border-color: tab.selected && !root.file-preview-open && !root.usage-open ? #7970ff : #29364b;
                                animate background, border-color { duration: 120ms; easing: ease-out; }
                                Text { x: 10px; width: parent.width - 48px; height: parent.height; text: tab.title; color: #e3e7f3; overflow: elide; vertical-alignment: center; }
                                ChatTouch {
                                    width: parent.width - 36px; height: parent.height;
                                    chat: !tab.id.starts-with("p");
                                    open => { root.select-row(tab.id); }
                                    close-tab => { root.close-tab(tab.id); }
                                    delete-chat => { root.delete-chat(tab.id); }
                                }
                                Rectangle {
                                    x: parent.width - 32px; y: 6px; width: 28px; height: 28px;
                                    border-radius: 5px;
                                    background: close-touch.has-hover ? #514f79 : transparent;
                                    animate background { duration: 100ms; easing: ease-out; }
                                    Text { text: "×"; color: #d1d8ea; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                                    close-touch := TouchArea { clicked => { root.close-tab(tab.id); } }
                                }
                            }
                            if root.usage-tab-open : Rectangle {
                                width: tab-scroll.item-width; border-radius: 7px;
                                background: root.usage-open ? #30316b : #192333;
                                border-width: 1px; border-color: root.usage-open ? #7970ff : #29364b;
                                Image { x: 10px; y: 12px; width: 16px; height: 16px; source: @image-url("assets/usage.svg"); }
                                Text { x: 32px; width: parent.width - 70px; height: parent.height; text: "Uso"; color: #e3e7f3; overflow: elide; vertical-alignment: center; }
                                TouchArea { width: parent.width - 36px; clicked => { root.open-usage(); } }
                                Rectangle {
                                    x: parent.width - 32px; y: 6px; width: 28px; height: 28px; border-radius: 5px;
                                    background: usage-close-touch.has-hover ? #514f79 : transparent;
                                    Text { text: "×"; color: #d1d8ea; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                                    usage-close-touch := TouchArea { clicked => { root.usage-tab-open = false; root.usage-open = false; } }
                                }
                            }
                            for tab in root.file-tabs : Rectangle {
                                private property <bool> selected: root.file-preview-open && root.file-preview-project == tab.project && root.file-preview-path == tab.path;
                                width: tab-scroll.item-width; border-radius: 7px;
                                background: self.selected ? #30316b : #192333;
                                border-width: 1px; border-color: self.selected ? #7970ff : #29364b;
                                animate background, border-color { duration: 120ms; easing: ease-out; }
                                Image { x: 10px; y: 12px; width: 16px; height: 16px; source: @image-url("assets/file.svg"); }
                                Text { x: 32px; width: parent.width - 70px; height: parent.height; text: tab.title; color: #e3e7f3; overflow: elide; vertical-alignment: center; }
                                TouchArea { width: parent.width - 36px; height: parent.height; clicked => { root.select-file-tab(tab.project, tab.path); } }
                                Rectangle {
                                    x: parent.width - 32px; y: 6px; width: 28px; height: 28px; border-radius: 5px;
                                    background: file-close-touch.has-hover ? #514f79 : transparent;
                                    animate background { duration: 100ms; }
                                    Text { text: "×"; color: #d1d8ea; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                                    file-close-touch := TouchArea { clicked => { root.close-file-tab(tab.project, tab.path); } }
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    clip: true;
                    background: #141f2c;
                    border-width: 1px;
                    border-color: #2b384e;
                    border-radius: 10px;
    if root.usage-open : Rectangle {
        width: parent.width; height: parent.height;
        clip: true; background: #172332; border-radius: 10px; border-width: 1px; border-color: #354460;
        VerticalBox {
            padding: 20px; spacing: 12px;
            HorizontalBox {
                height: 28px; padding: 0px; spacing: 6px;
                Image { source: @image-url("assets/usage.svg"); width: 18px; height: 18px; }
                Text { text: "Uso"; color: #e3e7f3; font-size: 22px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                if root.usage-busy : Image { source: @image-url("assets/quota-spinner.svg"); width: 14px; height: 14px; transform-origin: { x: self.width / 2, y: self.height / 2 }; transform-rotation: 360deg * mod(animation-tick(), 900ms) / 900ms; }
                IconButton { width: 28px; height: 28px; icon: @image-url("assets/folder.svg"); label: "Abrir informes de uso"; enabled: !root.usage-busy; clicked => { root.open-usage-report(); } }
                IconButton { width: 28px; height: 28px; icon: @image-url("assets/refresh.svg"); label: "Actualizar uso"; enabled: !root.usage-busy; clicked => { root.refresh-usage(); } }
            }
            Text { text: root.overview-name + "  ›  " + root.overview-path; color: #91a0bc; font-size: 12px; overflow: elide; }
            HorizontalBox {
                padding: 0px; spacing: 12px; height: 32px;
                ComboBox { width: 190px; height: 32px; model: ["Proyecto", "Chat actual"]; current-index <=> root.usage-scope; }
                ComboBox { width: 190px; height: 32px; model: ["Herramientas", "Llamadas", "Modelos", "Procesos"]; current-index <=> root.usage-view; }
                Rectangle { horizontal-stretch: 1; }
            }
            Text { text: root.usage-totals; color: #c9c3ff; font-size: 12px; wrap: word-wrap; }
            Text { text: root.usage-view == 3 ? "Estimación del comando y de las lecturas de su resultado. No es consumo de CPU ni facturación exacta; logs anteriores pueden no vincular esas lecturas." : root.usage-view == 2 ? "Entrada y salida informadas por el proveedor. Caché y razonamiento ya están incluidos en esos totales." : "≈ Estimación de argumentos + respuesta, a 4 caracteres por token. No mide facturación ni las relecturas del contexto. Logs antiguos: solo respuesta, estimada por bytes."; color: #91a0bc; font-size: 11px; wrap: word-wrap; }
            if root.usage-rows.length == 0 && !root.usage-busy : Text { text: "Todavía no hay métricas para esta vista. Los datos se registran al trabajar con los agentes."; color: #91a0bc; font-size: 12px; wrap: word-wrap; }
            ListView {
                for row in root.usage-rows : Rectangle {
                    height: 164px; background: #1d2a3b; border-radius: 7px;
                    VerticalBox {
                        padding: 10px; spacing: 4px;
                        Text { height: 28px; text: row.title; color: #e3e7f3; font-size: 12px; font-weight: 600; wrap: word-wrap; overflow: elide; }
                        Text { height: 22px; text: row.metric; color: #b4aaff; font-size: 17px; font-weight: 600; }
                        Rectangle { height: 6px; background: #303e55; border-radius: 3px;
                            Rectangle { x: 0px; width: parent.width * row.ratio; height: parent.height; background: #9387ff; border-radius: 3px; }
                        }
                        Text { height: 32px; text: row.detail; color: #b7c4d8; font-size: 10px; wrap: word-wrap; overflow: elide; }
                        Text { height: 24px; text: row.hint; color: #899bb8; font-size: 10px; wrap: word-wrap; overflow: elide; }
                    }
                }
            }
            Text { text: root.usage-status; color: #91a0bc; font-size: 10px; wrap: word-wrap; }
            Text { text: "Los procesos locales no gastan tokens por ejecutarse. Su salida cuenta cuando el agente la lee."; color: #91a0bc; font-size: 10px; wrap: word-wrap; }
        }
    }


                    VerticalBox {
                        visible: !root.file-preview-open && !root.project-overview && !root.usage-open;
                        padding: 16px;
                        spacing: 12px;
                        HorizontalBox {
                            padding: 0px; height: 28px;
                            Text { text: root.chat-title; color: #f0f2fa; font-size: 18px; font-weight: 600; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                            IconButton { width: 28px; height: 28px; icon: @image-url("assets/logcat.svg"); label: "Ver logs del chat"; enabled: root.has-chat; clicked => { root.open-logs(); } }
                        }
                        Rectangle { height: 1px; background: #2b384e; }
                        VerticalBox {
                            vertical-stretch: 1; padding: 12px; spacing: 10px;
                                if root.messages.length == 0 : Rectangle {
                                    height: empty-detail.y + empty-detail.height + 24px;
                                    vertical-stretch: 0;
                                    Image { y: 20px; source: @image-url("assets/workspace.svg"); width: 120px; height: 96px; }
                                    empty-title := Text { y: 132px; width: parent.width; height: self.preferred-height; text: root.has-chat ? "¿En qué trabajamos?" : "Todos tus proyectos en una ventana"; color: #dfe4f3; font-size: 20px; wrap: word-wrap; }
                                    empty-detail := Text { y: empty-title.y + empty-title.height + 12px; width: parent.width; height: self.preferred-height; text: !root.has-chat ? "Abrí una carpeta para crear tu primer chat." : root.codex-configured ? "Escribí un pedido para Codex. Las acciones que modifican archivos o ejecutan comandos requieren tu aprobación." : "Configurá un agente para empezar. Tus conversaciones se guardan en este equipo."; color: #91a0bc; wrap: word-wrap; }
                                }
                            chat-scroll := ListView {
                                vertical-stretch: 1;
                                content-width: self.visible-width;
                                horizontal-scrollbar-policy: always-off;
                                // Direct delegates let Slint instantiate only the visible rows.
                                for message[index] in ((root.file-preview-open || root.usage-open) ? [] : root.messages) : Rectangle {
                                    init => { root.profile-row-created("chat"); }
                                    width: chat-scroll.visible-width;
                                    height: message.body == "" ? 0px : bubble.height + 14px;
                                    bubble := ChatMessage {
                                        x: 0px; y: index == root.chat-entry-index ? (1 - root.chat-entry-progress) * 8px : 0px; width: parent.width;
                                        opacity: index == root.chat-entry-index ? root.chat-entry-progress : 1;
                                        message: message;
                                        defer-measurement: root.panel-dragging || root.projects-dragging;
                                        visibility-changed(active) => { root.chat-bubble-visibility(index, active); }
                                        measurement-epoch: root.chat-measurement-epoch;
                                        measure-requested => { root.chat-measure-requested(); }
                                    }
                                }

                            }
                        }
                        if root.has-chat && root.chat-running && root.approval-description == "" && !root.file-preview-open && !root.usage-open && !root.project-overview : Rectangle {
                            // Stretch in the parent layout. Reading the sibling
                            // ListView's allocated width here recurses into that layout.
                            height: 42px; horizontal-stretch: 1; vertical-stretch: 0;
                            Rectangle {
                                x: 0px; y: 0px; width: 76px; height: 42px;
                                background: #1c2836; border-radius: 10px;
                                accessible-role: text;
                                accessible-label: "El agente está trabajando o esperando una herramienta";
                                for index in [0, 1, 2] : Rectangle {
                                    x: 18px + index * 16px; y: 18px - 2px * Math.sin(360deg * mod(animation-tick(), 1400ms) / 1400ms - index * 60deg); width: 7px; height: 7px;
                                    border-radius: 3.5px; background: #b7afff;
                                    opacity: 0.65 + 0.35 * Math.sin(360deg * mod(animation-tick(), 1400ms) / 1400ms - index * 60deg);
                                }
                            }
                        }
                        if root.notice != "" : Text { text: root.notice; color: #a6b4cb; wrap: word-wrap; font-size: 12px; vertical-stretch: 0; }
                        if root.can-retry-message : Button {
                            text: "Reintentar solicitud";
                            accessible-label: "Reintentar la solicitud fallida";
                            height: 36px;
                            enabled: root.selected-agent-configured && !root.chat-running && !root.attachment-busy;
                            clicked => { root.retry-message(); }
                        }
                        if root.approval-description != "" : Rectangle {
                            height: 220px;
                            background: #292640;
                            border-radius: 8px;
                            VerticalBox {
                                padding: 10px;
                                Text { text: "Acción pendiente de aprobación"; color: #eee8ff; font-weight: 600; }
                                approval-scroll := ScrollView {
                                    content-width: self.visible-width;
                                    content-height: approval-text.height;
                                    horizontal-scrollbar-policy: always-off;
                                    approval-text := Text {
                                        x: 0px; y: 0px;
                                        width: approval-scroll.visible-width;
                                        height: self.preferred-height;
                                        text: root.approval-description;
                                        color: #d1cce0;
                                        font-family: "Consolas";
                                        font-size: 12px;
                                        vertical-alignment: top;
                                        wrap: word-wrap;
                                    }
                                }
                                HorizontalBox { Button { text: "Aprobar"; clicked => { root.approve-tool(true); } } Button { text: "Rechazar"; clicked => { root.approve-tool(false); } } }
                            }
                        }
                        Rectangle {
                            height: 96px + draft-editor.height + (root.attachment-rows.length > 0 ? 86px : 0px);
                            draft-measure := Text {
                                visible: false;
                                width: max(1px, draft-editor.width - 24px);
                                text: root.draft + "\u{200b}";
                                font-size: 14px; wrap: word-wrap;
                            }
                            border-radius: 9px; background: #192534; border-width: 1px; border-color: #34435c;
                            VerticalBox {
                                padding: 10px; spacing: 6px;
                                HorizontalBox {
                                    height: 32px; padding: 0px; spacing: 6px;
                                    ComboBox { min-width: 0px; max-width: 110px; horizontal-stretch: 1; height: 32px; model: root.available-agents; current-index <=> root.provider-index; enabled: root.has-chat && root.provider-editable && !root.chat-running; selected => { root.pick-chat-provider(self.current-index); } }
                                    ComboBox { min-width: 0px; max-width: 180px; horizontal-stretch: 2; height: 32px; model: root.chat-models; current-index <=> root.chat-model-index; enabled: root.has-chat && root.selected-agent-configured && !root.chat-running; selected => { root.pick-chat-model(self.current-index); } }
                                    ComboBox { min-width: 0px; max-width: 120px; horizontal-stretch: 1; height: 32px; model: root.chat-efforts; current-index <=> root.chat-effort-index; enabled: root.has-chat && root.selected-agent-configured && !root.chat-running; selected => { root.pick-chat-effort(self.current-index); } }
                                    Rectangle { horizontal-stretch: 1; min-width: 0px; }
                                }

                                if root.attachment-rows.length > 0 : ScrollView {
                                    height: 80px; vertical-scrollbar-policy: always-off;
                                    content-height: 74px; content-width: root.attachment-rows.length * 112px;
                                    for item[index] in root.attachment-rows : Rectangle {
                                        x: index * 112px; y: 0px; width: 104px; height: 74px;
                                        background: #253247; border-radius: 6px;
                                        Image { x: 4px; y: 4px; width: 96px; height: 48px; source: item.image; image-fit: contain; }
                                        Text { x: 6px; y: 55px; width: 92px; height: 15px; text: item.name; color: #bcc5d8; font-size: 10px; overflow: elide; }
                                        Button { x: 80px; y: 0px; width: 24px; height: 24px; text: "×"; accessible-label: "Quitar " + item.name; enabled: !root.chat-running && !root.attachment-busy; clicked => { root.remove-attachment(item.id); } }
                                    }
                                }
                                HorizontalBox {
                                    padding: 0px; spacing: 8px;
                                    height: draft-editor.height;
                                draft-editor := TextEdit {
                                    height: clamp(draft-measure.preferred-height + 24px, 44px, 220px);
                                    vertical-stretch: 0; horizontal-stretch: 1; min-width: 0px;
                                    wrap: word-wrap;
                                    text <=> root.draft; enabled: root.has-chat; font-size: 14px;
                                    key-pressed(event) => {
                                        if (event.text == Key.Return || event.text == "\n") && !event.modifiers.shift {
                                            if root.has-chat && root.selected-agent-configured && !root.chat-running && !root.attachment-busy && (root.draft != "" || root.attachment-rows.length > 0) {
                                                root.send-message(root.draft, root.provider-index);
                                            }
                                            return accept;
                                        }
                                        if event.modifiers.control && (event.text == "v" || event.text == "V" || event.text == "\u{0016}") {
                                            if root.paste-image() { return accept; }
                                        }
                                        return reject;
                                    }
                                }
                                    Rectangle {
                                        width: 32px; height: draft-editor.height;
                                    if root.chat-running : IconButton { x: 0px; y: (parent.height - 32px) / 2; width: 32px; height: 32px; icon: @image-url("assets/stop.svg"); label: "Detener respuesta"; clicked => { root.cancel-chat(); } }
                                    if !root.chat-running : IconButton { x: 0px; y: (parent.height - 32px) / 2; width: 32px; height: 32px; icon: @image-url("assets/send.svg"); label: "Enviar mensaje"; enabled: root.has-chat && root.selected-agent-configured && !root.chat-running && !root.attachment-busy && (root.draft != "" || root.attachment-rows.length > 0); clicked => { root.send-message(root.draft, root.provider-index); } }
                                    }
                                }
                                HorizontalBox {
                                    height: 32px; padding: 0px; spacing: 6px;
                                    IconButton { width: 32px; height: 32px; icon: @image-url("assets/attach.svg"); label: "Adjuntar imágenes"; enabled: root.has-chat && !root.chat-running && !root.attachment-busy && root.attachment-rows.length < 4; clicked => { root.attach-images(); } }
                                    Rectangle {
                                        width: 32px; height: 32px; border-radius: 5px;
                                        background: root.auto-approve-enabled ? #544629 : transparent;
                                        IconButton { width: 32px; height: 32px; icon: @image-url("assets/auto-approve.svg"); enabled: root.has-chat; label: root.auto-approve-enabled ? "Desactivar autoaprobación de este chat" : "Autoaprobar este chat: permite escrituras, comandos y HTTP sin confirmación durante esta sesión"; clicked => { root.toggle-auto-approve(); } }
                                    }
                                    Text { text: root.token-summary; color: #91a0bc; font-size: 11px; overflow: elide; min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; }
                                    HorizontalBox {
                                        padding: 0px; spacing: 6px; height: 32px;
                                        horizontal-stretch: 0;
                                        Text { text: root.context-summary; color: #a6b4cb; font-size: 11px; overflow: elide; min-width: 0px; horizontal-stretch: 0; vertical-alignment: center; }
                                        Rectangle {
                                            width: 64px; height: 32px; horizontal-stretch: 0;
                                            context-track := Rectangle {
                                                x: 0px; y: 13px; width: 64px; height: 6px;
                                                background: #29374b; border-radius: 3px;
                                                Rectangle {
                                                    x: 0px; y: 0px; height: context-track.height;
                                                    width: context-track.width * clamp(root.context-fraction, 0, 1);
                                                    background: root.context-fraction >= 0.85 ? #e5ad62 : #9182ff;
                                                    border-radius: min(3px, self.width / 2);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.project-overview && !root.file-preview-open && !root.usage-open : Rectangle {
                        background: #141f2c; border-width: 1px; border-color: #2b384e; border-radius: 10px;
                        VerticalBox {
                            padding: 20px; spacing: 16px;
                            HorizontalBox {
                                padding: 0px; spacing: 12px; height: 40px;
                                Image { source: @image-url("assets/folder.svg"); width: 32px; height: 32px; }
                                Text { text: root.overview-name; font-size: 24px; font-weight: 600; color: #f0f2fa; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                Button { text: "Nuevo chat"; icon: @image-url("assets/plus.svg"); height: 32px; clicked => { root.usage-open = false; root.new-chat(); } }
                            }
                            Text { text: root.overview-path; color: #91a0bc; font-size: 12px; overflow: elide; }
                            Rectangle { height: 1px; background: #2b384e; }
                            HorizontalBox {
                                padding: 0px; spacing: 6px; height: 32px;
                                Button { text: "Resumen"; enabled: root.project-tasks-view || root.project-settings-view; clicked => { root.project-tasks-view = false; root.project-settings-view = false; } }
                                Button { text: "Tareas"; enabled: !root.project-tasks-view || root.project-settings-view; clicked => { root.project-tasks-view = true; root.project-settings-view = false; } }
                                Button { text: "Configuración"; icon: @image-url("assets/settings.svg"); enabled: !root.project-settings-view; clicked => { root.open-project-config(); } }
                                Rectangle { horizontal-stretch: 1; }
                                if root.project-tasks-view : Button { text: "Nueva tarea"; icon: @image-url("assets/plus.svg"); clicked => { root.edit-task(""); } }
                            }
                            if !root.project-tasks-view && !root.project-settings-view : VerticalBox {
                                padding: 0px; spacing: 16px;
                            if root.overview-description != "" : Text { text: root.overview-description; color: #dfe4f3; font-size: 13px; wrap: word-wrap; }
                            HorizontalBox {
                                padding: 0px; spacing: 12px; height: 78px;
                                Rectangle { horizontal-stretch: 1; background: #192534; border-radius: 8px;
                                    VerticalBox { padding: 12px; spacing: 4px;
                                        Text { text: root.project-chat-count; color: #eee8ff; font-size: 24px; }
                                        Text { text: "Chats"; color: #91a0bc; font-size: 12px; }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; background: #192534; border-radius: 8px;
                                    VerticalBox { padding: 12px; spacing: 4px;
                                        Text { text: root.project-running-count; color: #78c99b; font-size: 24px; }
                                        Text { text: "En curso"; color: #91a0bc; font-size: 12px; }
                                    }
                                }
                            }
                            HorizontalBox {
                                padding: 0px; spacing: 8px; height: 32px;
                                Button { text: "Git"; icon: @image-url("assets/git.svg"); clicked => { root.git-open = true; } }
                                Button { text: "Archivos"; icon: @image-url("assets/folder.svg"); clicked => { root.files-open = true; } }
                                Button { text: "Abrir carpeta"; clicked => { root.open-project-folder(); } }
                            }
                            Text { text: "Chats del proyecto"; color: #dfe4f3; font-weight: 600; font-size: 14px; }
                            if root.project-chats.length == 0 : Text { text: "Creá un chat para empezar a trabajar en este proyecto."; color: #91a0bc; wrap: word-wrap; }
                            ListView {
                                horizontal-scrollbar-policy: always-off;
                                for chat in root.project-chats : Rectangle {
                                    height: 66px;
                                    Rectangle { height: parent.height - 6px; width: parent.width; background: project-chat-touch.has-hover ? #253448 : #192534; border-radius: 7px; }
                                    Image { x: 12px; y: 20px; width: 20px; height: 20px; source: @image-url("assets/chat.svg"); }
                                    Text { x: 44px; y: 10px; width: max(0px, parent.width - 188px); height: 20px; text: chat.title; color: #e3e7f3; font-size: 13px; overflow: elide; }
                                    Text { x: 44px; y: 32px; width: max(0px, parent.width - 188px); height: 18px; text: chat.detail; color: #91a0bc; font-size: 11px; overflow: elide; }
                                    Text { x: parent.width - 136px; width: 124px; height: 60px; text: chat.status; color: chat.running ? #78c99b : #91a0bc; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                    project-chat-touch := TouchArea { clicked => { root.select-row(chat.id); } }
                                }
                            }
                            }
                            if root.project-settings-view : VerticalBox {
                                padding: 0px; spacing: 10px;
                                ScrollView {
                                    horizontal-scrollbar-policy: always-off;
                                    content-width: self.visible-width;
                                    VerticalBox {
                                        width: parent.visible-width; padding: 0px; padding-right: 8px; spacing: 10px;
                                        Text { text: "Descripción breve"; color: #dfe4f3; font-weight: 600; }
                                        TextEdit { wrap: word-wrap; text <=> root.project-description; height: 64px; }
                                        HorizontalBox {
                                            padding: 0px; height: 30px;
                                            Text { text: "Compilación"; color: #dfe4f3; font-weight: 600; horizontal-stretch: 1; }
                                            Button { text: "Agregar comando"; icon: @image-url("assets/plus.svg"); clicked => { root.add-build-command(); } }
                                        }
                                        for build[index] in root.project-build-commands : Rectangle {
                                            height: 96px; background: #192534; border-radius: 7px;
                                            VerticalBox {
                                                padding: 10px; spacing: 6px;
                                                HorizontalBox {
                                                    padding: 0px; spacing: 6px;
                                                    LineEdit { text: build.command; placeholder-text: "Comando, por ejemplo: cargo build --release"; horizontal-stretch: 1; edited => { root.edit-build-command(index, self.text, build.purpose); } }
                                                    IconButton { width: 30px; height: 30px; icon: @image-url("assets/minus.svg"); label: "Eliminar comando"; clicked => { root.remove-build-command(index); } }
                                                }
                                                LineEdit { text: build.purpose; placeholder-text: "Cuándo usarlo, por ejemplo: generar la versión de distribución"; edited => { root.edit-build-command(index, build.command, self.text); } }
                                            }
                                        }
                                        if root.project-build-commands.length == 0 : Text { text: "Agregá un comando para cada caso: desarrollo, release u otras variantes."; color: #91a0bc; font-size: 12px; wrap: word-wrap; }
                                        Text { text: "Comando de tests"; color: #dfe4f3; font-weight: 600; }
                                        LineEdit { text <=> root.project-test-command; placeholder-text: "Por ejemplo: cargo test --offline"; }
                                        HorizontalBox {
                                            padding: 0px; spacing: 6px; height: 30px;
                                            Text { text: "Reglas básicas del proyecto"; color: #dfe4f3; font-weight: 600; horizontal-stretch: 1; }
                                            Button { text: "Cargar Codex"; clicked => { root.import-project-rules(0); } }
                                            Button { text: "Cargar Claude"; clicked => { root.import-project-rules(1); } }
                                            Button { text: "Ambos"; clicked => { root.import-project-rules(2); } }
                                        }
                                        TextEdit { wrap: word-wrap; text <=> root.project-rules; height: 220px; }
                                    }
                                }
                                if root.project-config-message != "" : Text { text: root.project-config-message; color: #b7afff; font-size: 12px; wrap: word-wrap; }
                                HorizontalBox {
                                    padding: 0px; spacing: 8px; height: 32px;
                                    Text { text: "Los comandos se ejecutan en la carpeta del proyecto."; color: #91a0bc; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; }
                                    Button { text: "Guardar"; clicked => { root.save-project-config(); } }
                                }
                            }
                            if root.project-tasks-view && !root.project-settings-view : VerticalBox {
                                padding: 0px; spacing: 10px;
                                HorizontalBox {
                                    padding: 0px; spacing: 8px; height: 32px;
                                    ComboBox { model: root.available-agents; current-index <=> root.queue-provider-index; width: 120px; enabled: root.queue-configured && !root.queue-running && !root.queue-active; }
                                    if !root.queue-running : Button { text: "Ejecutar cola"; icon: @image-url("assets/play.svg"); enabled: root.queue-configured && !root.queue-active && root.tasks-todo.length > 0; clicked => { root.run-task-queue(); } }
                                    if root.queue-running : Button { text: "Pausar cola"; icon: @image-url("assets/pause.svg"); clicked => { root.pause-task-queue(); } }
                                    if root.queue-chat != "" : Button { text: "Abrir chat actual"; icon: @image-url("assets/chat.svg"); clicked => { root.select-row(root.queue-chat); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                if root.queue-message != "" : Text { text: root.queue-message; color: #91a0bc; wrap: word-wrap; font-size: 11px; }
                                if root.task-error != "" && !root.task-dialog-open : Text { text: root.task-error; color: #ed9696; wrap: word-wrap; font-size: 12px; }
                                task-board := ScrollView {
                                    content-width: max(self.visible-width, 744px); content-height: self.visible-height;
                                    vertical-scrollbar-policy: always-off;
                                    HorizontalBox {
                                        width: task-board.content-width; height: task-board.visible-height; min-width: 0px; min-height: 0px;
                                        padding: 0px; spacing: 12px;
                                        TaskColumn { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; title: "Por hacer"; accent: #b7afff; tasks: root.tasks-todo; edit(id) => { root.edit-task(id); } open-chat(id) => { root.select-row(id); } }
                                        TaskColumn { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; title: "En progreso"; accent: #dcb27c; tasks: root.tasks-progress; edit(id) => { root.edit-task(id); } open-chat(id) => { root.select-row(id); } }
                                        TaskColumn { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; title: "Realizadas"; accent: #78c99b; tasks: root.tasks-done; edit(id) => { root.edit-task(id); } open-chat(id) => { root.select-row(id); } }
                                    }
                                }
                            }
                        }
                    }
                    if root.file-preview-open : Rectangle {
                        background: #141f2c; border-width: 1px; border-color: #2b384e; border-radius: 10px;
                        VerticalBox {
                            padding: 16px; spacing: 10px;
                            file-viewer := FileViewer { target-line: root.file-target-line; lines: root.file-preview-lines; columns: root.file-preview-columns; row-created => { root.profile-row-created("file"); } }
                            Rectangle {
                                height: 26px; background: #172332; border-radius: 4px;
                                HorizontalBox {
                                    padding-left: 8px; padding-right: 8px; padding-top: 0px; padding-bottom: 0px; spacing: 12px;
                                    Text { text: root.file-preview-location; color: #91a0bc; font-size: 11px; vertical-alignment: center; overflow: elide; min-width: 0px; horizontal-stretch: 1; }
                                    Text { text: root.file-preview-status; color: #91a0bc; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.git-open || root.git-progress > 0 : Rectangle {
        x: root.width - self.width - 14px + (1 - root.git-progress) * (self.width + 14px); y: 58px; width: root.panel-width; height: root.height - 72px;
        background: #121d29; border-color: #384561; border-width: 1px; border-radius: 10px;
        VerticalBox {
            padding: 12px; spacing: 10px;
            HorizontalBox {
                padding: 0px; spacing: 6px; height: 32px;
                Rectangle {
                    height: 32px; horizontal-stretch: 1; border-radius: 7px; border-width: 1px;
                    border-color: #34435c; background: #1b2737;
                    Rectangle {
                        x: root.git-history-view ? 2px + self.width : 2px;
                        y: 2px; width: (parent.width - 4px) / 2; height: parent.height - 4px;
                        border-radius: 5px; border-width: 1px; border-color: #7970ff; background: #30316b;
                        animate x { duration: 120ms; easing: ease-out; }
                    }
                    Text { x: 0px; width: parent.width / 2; height: parent.height; text: "Cambios"; color: !root.git-history-view ? #eee8ff : #91a0bc; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                    Text { x: parent.width / 2; width: parent.width / 2; height: parent.height; text: "Historial"; color: root.git-history-view ? #eee8ff : #91a0bc; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                    TouchArea { width: parent.width / 2; clicked => { root.git-history-view = false; } }
                    TouchArea { x: parent.width / 2; width: parent.width / 2; clicked => { root.git-history-view = true; } }
                }
                if root.git-repository : IconButton { width: 32px; height: 32px; icon: @image-url("assets/settings.svg"); label: "Configurar Git"; enabled: !root.git-busy; clicked => { root.git-remote-url = root.git-origin-url; root.git-user-name = root.git-author-name; root.git-user-email = root.git-author-email; root.git-action-message = ""; root.git-settings-open = true; } }
            }
            if root.git-status != "" : Text { text: root.git-status; color: #91a0bc; wrap: word-wrap; font-size: 11px; }
            if root.git-action-message != "" : ScrollView {
                height: min(72px, git-action-text.preferred-height);
                content-width: self.visible-width; horizontal-scrollbar-policy: always-off;
                git-action-text := Text { text: root.git-action-message; color: #dfe4f3; wrap: word-wrap; font-size: 11px; }
            }
            HorizontalBox {
                padding: 0px; spacing: 6px; height: 32px;
                IconButton { width: 32px; height: 32px; icon: @image-url("assets/refresh.svg"); label: "Actualizar Git"; enabled: !root.git-busy && root.git-project != ""; clicked => { root.refresh-git(); } }
                if root.git-repository : ComboBox {
                    min-width: 0px; max-width: 100000px; horizontal-stretch: 1; height: 32px;
                    model: root.git-branches; current-index <=> root.git-branch-index;
                    enabled: !root.git-busy && !root.git-dirty && root.git-branches.length > 1;
                    selected => { root.git-action("switch", root.git-branches[self.current-index]); }
                }
                if root.git-repository : IconButton { width: 32px; height: 32px; icon: @image-url("assets/pull.svg"); label: "Pull: traer cambios"; enabled: !root.git-busy && root.git-remote; clicked => { root.git-action("pull", ""); } }
                if root.git-repository : IconButton { width: 32px; height: 32px; icon: @image-url("assets/push.svg"); label: "Push: publicar commits"; enabled: !root.git-busy && root.git-remote; clicked => { root.git-action("push", ""); } }
            }
            if root.git-known && !root.git-repository : Button {
                text: "Inicializar repositorio"; height: 32px; enabled: !root.git-busy;
                clicked => { root.git-action("init", ""); }
            }
            if !root.git-history-view && root.git-repository && root.git-files.length == 0 : Text { text: "No hay archivos con cambios."; color: #91a0bc; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
            if root.git-history-view && root.git-repository && root.git-history.length == 0 : Text { text: "Todavía no hay commits."; color: #91a0bc; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
            if !root.git-history-view : git-changes-list := ListView {
                vertical-stretch: 1; content-width: self.visible-width;
                horizontal-scrollbar-policy: always-off;
                for file in root.git-files : Rectangle {
                    init => { root.profile-row-created("git_changes"); }
                    width: git-changes-list.visible-width; height: 40px;
                    background: file.header ? #192534 : git-file-touch.has-hover ? #223145 : transparent;
                    if file.header : Text {
                        x: 8px; width: parent.width - (file.prepared ? 16px : 132px); height: parent.height;
                        text: file.name; color: #c8cde0; font-size: 11px; font-weight: 600;
                        vertical-alignment: center;
                    }
                    if file.header && !file.prepared : Rectangle {
                        x: parent.width - 118px; width: 110px; height: parent.height;
                        accessible-role: button; accessible-label: "Seleccionar todos";
                        accessible-enabled: !root.git-busy;
                        accessible-action-default => { if !root.git-busy { root.git-action("stage-all", ""); } }
                        forward-focus: select-all-focus;
                        Text { width: parent.width; height: parent.height; text: "Seleccionar todos"; font-size: 11px; color: root.git-busy ? #68738b : select-all-touch.has-hover ? #d5cfff : #b7afff; horizontal-alignment: right; vertical-alignment: center; }
                        select-all-touch := TouchArea { enabled: !root.git-busy; clicked => { root.git-action("stage-all", ""); } }
                        select-all-focus := FocusScope {
                            x: 0px; width: 0px; enabled: !root.git-busy;
                            key-pressed(event) => { if event.text == " " || event.text == "\n" { root.git-action("stage-all", ""); return accept; } return reject; }
                        }
                    }
                    git-file-touch := TouchArea {
                        enabled: !file.header && !root.git-busy;
                        x: 34px; width: parent.width - 34px;
                        clicked => { root.git-file-diff(file.target, file.prepared); }
                    }
                    if !file.header : HorizontalBox {
                        x: 7px; width: parent.width - 14px; height: parent.height; padding: 0px; spacing: 5px;
                        Rectangle {
                            width: 24px; height: 40px;
                            GitSelectionCheckbox {
                                y: 8px; checked: file.prepared; enabled: !root.git-busy;
                                label: (file.prepared ? "Retirar del commit " : "Preparar para commit ") + file.path;
                                toggled => { root.git-action(file.prepared ? "unstage" : "stage", file.target); }
                            }
                        }
                        Rectangle { width: 16px; height: 40px; Image { y: 12px; width: 16px; height: 16px; source: @image-url("assets/file.svg"); } }
                        Rectangle {
                            horizontal-stretch: 1; min-width: 0px; height: 40px;
                            Text { y: file.directory == "" ? 10px : 4px; width: parent.width; height: 18px; text: file.name; color: #e3e7f3; font-size: 12px; overflow: elide; vertical-alignment: center; }
                            if file.directory != "" : Text { y: 22px; width: parent.width; height: 14px; text: file.directory; color: #8291ad; font-size: 10px; overflow: elide; vertical-alignment: center; }
                        }
                        if file.added != "" : Text { text: file.added; color: #78c99b; font-size: 11px; vertical-alignment: center; }
                        if file.removed != "" : Text { text: file.removed; color: #ed9696; font-size: 11px; vertical-alignment: center; }
                        if file.stats != "" : Text { text: file.stats; color: #8291ad; font-size: 10px; vertical-alignment: center; }
                        Text { text: file.code; color: file.status == "Conflicto" ? #ec9c85 : file.code == "D" ? #ed9696 : file.code == "A" || file.code == "U" ? #78c99b : #dcb27c; font-size: 11px; vertical-alignment: center; width: 12px; horizontal-alignment: center; }

                    }
                }
            }

            if root.git-history-view : git-history-list := ListView {
                vertical-stretch: 1; content-width: self.visible-width;
                horizontal-scrollbar-policy: always-off;
                    for commit in root.git-history : Rectangle {
                        init => { root.profile-row-created("git_history"); }
                        width: git-history-list.visible-width; height: 76px;
                        accessible-role: button; accessible-label: commit.title + " · " + commit.detail;
                        Rectangle { width: parent.width; height: parent.height - 8px; background: commit-touch.has-hover ? #253448 : #1c2939; border-radius: 6px; }
                        commit-title := Text { x: 9px; y: 8px; width: parent.width - 18px; height: 20px; text: commit.title; color: #e3e7f3; overflow: elide; wrap: no-wrap; font-size: 12px; }
                        commit-detail := Text { x: 9px; y: 32px; width: parent.width - 18px; height: 28px; text: commit.detail; color: #91a0bc; wrap: word-wrap; overflow: elide; font-size: 10px; }
                        commit-touch := TouchArea { enabled: !root.git-busy; clicked => { root.git-diff(commit.id, true); } }
                    }
            }
            if root.git-repository && !root.git-history-view : Rectangle {
                height: 140px;
                border-radius: 9px; background: #192534;
                border-width: 1px; border-color: #34435c;
                VerticalBox {
                    padding: 10px; spacing: 8px;
                    TextEdit {
                        text <=> root.git-commit-message; placeholder-text: "Mensaje del commit…";
                        enabled: !root.git-busy; font-size: 14px; min-height: 0px;
                    }
                    Button {
                        text: "Commit"; icon: @image-url("assets/git.svg"); height: 32px; horizontal-stretch: 1;
                        enabled: !root.git-busy && root.git-has-staged && root.git-commit-message != "";
                        clicked => { root.git-action("commit", root.git-commit-message); }
                    }
                }
            }
        }
    }

    if root.files-open || root.files-progress > 0 : Rectangle {
        x: root.width - self.width - 14px + (1 - root.files-progress) * (self.width + 14px); y: 58px; width: root.panel-width; height: root.height - 72px;
        background: #121d29; border-color: #384561; border-width: 1px; border-radius: 10px;
        VerticalBox {
            padding: 12px; spacing: 9px;
            HorizontalBox {
                padding: 0px;
                Text { text: "Archivos"; color: #eee8ff; font-size: 17px; font-weight: 600; horizontal-stretch: 1; }
                Button { text: "Cerrar"; width: 65px; height: 28px; clicked => { root.files-open = false; } }
            }
            Text { text: root.project-path; color: #91a0bc; font-size: 10px; overflow: elide; }
            Text { text: root.explorer-status; color: #91a0bc; font-size: 11px; wrap: word-wrap; }
            HorizontalBox {
                padding: 0px;
                Button { text: "Actualizar"; height: 28px; enabled: !root.explorer-busy; clicked => { root.refresh-explorer(true); } }
                Button { text: "Abrir carpeta"; height: 28px; enabled: root.has-project; clicked => { root.open-project-folder(); } }
            }
            ScrollView {
                content-width: self.visible-width; horizontal-scrollbar-policy: always-off;
                VerticalBox {
                    padding: 0px; spacing: 2px; vertical-stretch: 0;
                    for file in root.explorer-rows : Rectangle {
                        height: 29px; border-radius: 5px;
                        background: file-touch.has-hover ? #243247 : transparent;
                        animate background { duration: 100ms; }
                        Image { x: min(file.depth * 12px, 120px); y: 7px; width: 14px; height: 14px; visible: file.directory; source: file.expanded ? @image-url("assets/chevron-down.svg") : @image-url("assets/chevron-right.svg"); }
                        Image { x: min(file.depth * 12px, 120px) + 17px; y: 6px; width: 16px; height: 16px; source: file.directory ? @image-url("assets/folder.svg") : @image-url("assets/file.svg"); }
                        Text { x: min(file.depth * 12px, 120px) + 39px; width: parent.width - self.x - 5px; height: parent.height; text: file.name; color: #dfe4f3; font-size: 12px; vertical-alignment: center; overflow: elide; }
                        file-touch := TouchArea { enabled: !root.explorer-busy; clicked => { root.select-file(file.path); } }
                    }
                }
            }
        }
    }

    if root.logcat-open || root.logcat-progress > 0 : Rectangle {
        x: root.width - self.width - 14px + (1 - root.logcat-progress) * (self.width + 14px);
        y: 58px; width: root.panel-width; height: root.height - 72px;
        background: #121d29; border-color: #384561; border-width: 1px; border-radius: 10px;
        VerticalBox {
            padding: 12px; spacing: 9px;
            ComboBox { height: 32px; model: root.logcat-devices; current-index <=> root.logcat-device-index; enabled: !root.logcat-busy; selected => { root.select-logcat-device(self.current-index); } }
            HorizontalBox {
                padding: 0px; spacing: 6px;
                IconButton {
                    width: 32px; height: 32px;
                    icon: root.logcat-running ? @image-url("assets/pause.svg") : @image-url("assets/play.svg");
                    label: root.logcat-running ? "Pausar Logcat" : "Iniciar Logcat";
                    enabled: root.logcat-running || (root.logcat-device-ready && !root.logcat-busy);
                    clicked => { if root.logcat-running { root.stop-logcat(); } else { root.start-logcat(); } }
                }
                ComboBox { model: ["Verbose+", "Debug+", "Info+", "Warning+", "Error+", "Fatal"]; current-index <=> root.logcat-level; horizontal-stretch: 1; selected => { root.filter-logcat(); } }
                CheckBox { text: "Seguir"; checked <=> root.logcat-follow; }
            }
            if root.logcat-error != "" : Text { text: root.logcat-error; color: #ec9c85; wrap: word-wrap; font-size: 11px; }
            log-scroll := ListView {
                private property <bool> following: root.logcat-follow;
                changed following => { if self.following { self.content-y = min(0px, self.visible-height - self.content-height); } }
                vertical-stretch: 1;
                content-width: max(self.visible-width, root.logcat-columns * 7.5px + 12px);
                changed content-height => { if root.logcat-follow { self.content-y = min(0px, self.visible-height - self.content-height); } }
                changed visible-height => { if root.logcat-follow { self.content-y = min(0px, self.visible-height - self.content-height); } }
                for line in root.logcat-lines : Rectangle {
                    height: 20px; width: log-scroll.content-width;
                    TextInput { x: 4px; height: 20px; width: parent.width - 8px; text: line.text; font-family: "Consolas"; font-size: 12px; read-only: true; wrap: no-wrap; vertical-alignment: center; color: line.level == "E" || line.level == "F" ? #ec9c85 : line.level == "W" ? #e3aa63 : #dfe4f3; }
                }
            }
            Rectangle { height: 1px; background: #27354a; }
            HorizontalBox {
                padding: 0px; spacing: 6px; height: 32px;
                LineEdit { height: 32px; horizontal-stretch: 1; text <=> root.logcat-filter; placeholder-text: "Filtrar texto, tag o PID…"; edited => { root.filter-logcat(); } }
                IconButton { width: 32px; height: 32px; icon: @image-url("assets/clear.svg"); label: "Limpiar buffer local de Logcat"; clicked => { root.clear-logcat(); } }
            }
        }
    }


    if root.flows-open : Rectangle {
        x: root.width - self.width - 14px; y: 58px;
        width: root.panel-width; height: root.height - 72px;
        clip: true; background: #172332; border-radius: 10px; border-width: 1px; border-color: #354460;
        VerticalBox {
            padding: 12px; spacing: 5px;
            HorizontalBox {
                height: 28px;
                Text { text: "Navegador / Flujos"; color: #e3e7f3; font-size: 16px; horizontal-stretch: 1; }
                IconButton { width: 28px; height: 28px; icon: @image-url("assets/refresh.svg"); label: "Actualizar flujos (descarta ediciones locales)"; clicked => { root.refresh-flows(); } }
            }
            ComboBox { height: 32px; model: root.flow-names; current-index <=> root.flow-index; selected => { root.pick-flow(self.current-index); } }
            LineEdit { height: 32px; text <=> root.flow-name; placeholder-text: "Nombre del test"; }
            LineEdit { height: 32px; text <=> root.flow-base-url; placeholder-text: "URL base (FLOW_BASE_URL)"; }
            LineEdit { height: 32px; text <=> root.flow-path; placeholder-text: "Ruta relativa: tests/flujo.spec.ts"; }
            Text { text: root.flow-notice; color: #91a0bc; font-size: 10px; wrap: word-wrap; max-height: 48px; overflow: elide; }
            ListView {
                min-height: 70px; vertical-stretch: 1;
                for step in root.flow-steps : Rectangle {
                    height: 58px; background: #101822;
                    HorizontalBox {
                        padding: 4px; spacing: 4px;
                        CheckBox { width: 28px; checked: step.included; toggled => { root.toggle-flow-step(step.index); } }
                        Rectangle {
                            horizontal-stretch: 1;
                            VerticalBox {
                                padding: 0px; spacing: 2px;
                                Text { text: step.title; color: #e3e7f3; font-size: 11px; overflow: elide; }
                                Text { text: step.detail; color: #91a0bc; font-size: 10px; overflow: elide; }
                            }
                            TouchArea { clicked => { root.pick-flow-step(step.index); } }
                        }
                    }
                }
            }
            Text { text: root.flow-detail; color: #91a0bc; font-size: 10px; wrap: word-wrap; max-height: 44px; overflow: elide; }
            Rectangle { height: 90px; background: #101822; Image { width: parent.width; height: parent.height; source: root.flow-image; image-fit: contain; } }
            ComboBox { height: 28px; model: ["Texto esperado", "URL esperada", "Elemento visible"]; current-index <=> root.flow-assert-kind; }
            if root.flow-assert-kind == 2 : LineEdit { height: 28px; text <=> root.flow-assert-target; placeholder-text: "Selector CSS estable"; }
            if root.flow-assert-kind != 2 : LineEdit { height: 28px; text <=> root.flow-assert-value; placeholder-text: "Valor esperado"; }
            Button { height: 28px; text: "Añadir verificación al final"; enabled: root.flow-steps.length > 0; clicked => { root.add-flow-assertion(); } }
            Button { height: 32px; text: "Previsualizar test…"; enabled: root.flow-steps.length > 0; clicked => { root.preview-flow-test(); } }
        }
    }

    // Resize the panel and workspace together, preserving a usable chat width.
    if root.captures-open || root.captures-progress > 0 : Rectangle {
        x: root.width - self.width - 14px + (1 - root.captures-progress) * (self.width + 14px);
        y: 58px; width: root.panel-width; height: root.height - 72px;
        clip: true; background: #172332; border-radius: 10px; border-width: 1px; border-color: #354460;
        VerticalBox {
            padding: 12px; spacing: 8px;
            HorizontalBox {
                height: 28px; padding: 0px;
                Image { source: @image-url("assets/captures.svg"); width: 18px; height: 18px; }
                Text { text: "Imágenes"; color: #e3e7f3; font-size: 17px; horizontal-stretch: 1; vertical-alignment: center; }
                IconButton { width: 28px; height: 28px; icon: @image-url("assets/refresh.svg"); label: "Actualizar imágenes"; clicked => { root.refresh-captures(); } }
            }
            ComboBox { height: 32px; model: ["Proyecto", "Chat actual"]; current-index <=> root.captures-scope; }
            Text { text: root.captures-notice; color: #91a0bc; font-size: 11px; wrap: word-wrap; max-height: 64px; overflow: elide; }
            ListView {
                min-height: 80px; vertical-stretch: 1;
                for capture in root.captures-rows : Rectangle {
                    height: 52px; background: capture-touch.has-hover ? #253447 : transparent;
                    VerticalBox {
                        padding: 6px; spacing: 4px;
                        Text { text: capture.name; color: #e3e7f3; overflow: elide; }
                        Text { text: capture.detail; color: #91a0bc; font-size: 11px; overflow: elide; }
                    }
                    capture-touch := TouchArea { clicked => { root.pick-capture(capture.index); } }
                }
            }
            if root.captures-title != "" : Text { text: root.captures-title; color: #e3e7f3; overflow: elide; }
            if root.captures-title != "" : Rectangle {
                height: 190px; background: #101822; border-radius: 6px;
                Image { width: parent.width; height: parent.height; source: root.captures-image; image-fit: contain; }
                TouchArea { clicked => { root.capture-preview-open = true; } }
            }
        }
    }
    if root.http-open || root.http-progress > 0 : Rectangle {
        x: root.width - self.width - 14px + (1 - root.http-progress) * (self.width + 14px);
        y: 58px; width: root.panel-width; height: root.height - 72px;
        clip: true; background: #172332; border-radius: 10px; border-width: 1px; border-color: #354460;
        VerticalBox {
            padding: 12px; spacing: 6px;
            HorizontalBox {
                height: 28px; padding: 0px; spacing: 4px;
                Image { source: @image-url("assets/http.svg"); width: 18px; height: 18px; }
                Text { text: "HTTP"; color: #e3e7f3; font-size: 17px; horizontal-stretch: 1; vertical-alignment: center; }
                IconButton { width: 28px; height: 28px; icon: @image-url("assets/settings.svg"); label: "Variables y timeout del proyecto"; enabled: root.http-ready && !root.http-busy; clicked => { root.http-action("variables"); } }
                IconButton { width: 28px; height: 28px; icon: @image-url("assets/folder.svg"); label: "Abrir respuestas guardadas"; clicked => { root.open-http-results(); } }
            }
            HorizontalBox {
                height: 32px; padding: 0px; spacing: 4px;
                ComboBox { min-width: 0px; horizontal-stretch: 1; height: 32px; model: root.http-request-names; current-index: root.http-request-index; enabled: root.http-ready && !root.http-busy && root.http-collections.length > 0; selected => { if self.current-index == root.http-requests.length { root.http-action("request"); } else { root.pick-http-request(root.http-requests[self.current-index].id); } } }
                IconButton { width: 28px; height: 28px; icon: @image-url("assets/edit.svg"); label: "Editar request"; enabled: !root.http-busy && root.http-request-id != ""; clicked => { root.http-rename-collection = false; root.http-rename-name = root.http-request-name; root.http-rename-open = true; } }
                if root.http-dirty : IconButton { width: 28px; height: 28px; icon: @image-url("assets/diskette.svg"); label: "Guardar cambios"; enabled: root.http-ready && !root.http-busy && root.http-collections.length > 0; clicked => { root.http-action("save"); } }
            }
            HorizontalBox {
                height: 32px; padding: 0px; spacing: 6px;
                ComboBox { width: 90px; height: 32px; model: ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]; current-index <=> root.http-method-index; enabled: !root.http-busy; }
                LineEdit { height: 32px; min-width: 0px; horizontal-stretch: 1; text <=> root.http-url; placeholder-text: "{{BASE_URL}}/ruta"; enabled: !root.http-busy; }
                IconButton { width: 32px; height: 32px; icon: root.http-busy ? @image-url("assets/stop.svg") : @image-url("assets/send.svg"); label: root.http-busy ? "Cancelar petición" : "Enviar petición"; enabled: root.http-busy || root.http-request-id != ""; clicked => { if root.http-busy { root.cancel-http(); } else { root.send-http(); } } }
            }
            HttpSegments { labels: ["Body", "Headers"]; current-index <=> root.http-request-view; }
            if root.http-request-view == 0 : TextEdit { height: 100px; text <=> root.http-body; enabled: !root.http-busy && root.http-request-id != ""; }
            if root.http-request-view == 1 : TextEdit { height: 100px; text <=> root.http-headers; enabled: !root.http-busy && root.http-request-id != ""; }
            if root.http-response-status != "" : HttpSegments { labels: ["Respuesta", "Headers"]; current-index <=> root.http-response-view; }
            Text { text: root.http-response-status; color: #b4aaff; font-size: 10px; overflow: elide; }
            FileViewer { lines: root.http-response-lines; columns: root.http-response-columns; target-line: 0; }
            Text { text: root.http-notice; color: #91a0bc; font-size: 10px; wrap: word-wrap; max-height: 48px; overflow: elide; }
            Rectangle {
                vertical-stretch: 0;
                border-radius: 9px; background: #192534; border-width: 1px; border-color: #34435c;
                VerticalBox {
                    padding: 10px; spacing: 6px;
                    HorizontalBox {
                        height: 32px; padding: 0px; spacing: 4px;
                        ComboBox { min-width: 0px; horizontal-stretch: 1; height: 32px; model: root.http-collections; current-index <=> root.http-collection-index; enabled: !root.http-busy; selected => { root.pick-http-collection(self.current-index); } }
                        IconButton { width: 28px; height: 28px; icon: @image-url("assets/edit.svg"); label: "Renombrar colección"; enabled: root.http-ready && !root.http-busy && root.http-collections.length > 0; clicked => { root.http-rename-collection = true; root.http-rename-name = root.http-collection-name; root.http-rename-open = true; } }
                        IconButton { width: 28px; height: 28px; icon: @image-url("assets/plus.svg"); label: "Nueva colección"; enabled: root.http-ready && !root.http-busy; clicked => { root.http-action("collection"); } }
                        IconButton { width: 28px; height: 28px; icon: @image-url("assets/minus.svg"); label: "Eliminar colección"; enabled: root.http-ready && !root.http-busy && root.http-collections.length > 0; clicked => { root.http-action("delete-collection"); } }
                    }
                    CheckBox { text: "Exponer a agentes"; checked <=> root.http-exposed; enabled: !root.http-busy && root.http-collections.length > 0; toggled => { root.http-notice = "Guardá para aplicar la exposición a agentes."; } }
                }
            }
        }
    }
    if root.terminal-open || root.terminal-progress > 0 : Rectangle {
        x: root.width - self.width - 14px + (1 - root.terminal-progress) * (self.width + 14px);
        y: 58px; width: root.panel-width; height: root.height - 72px;
        background: #121d29; border-color: #384561; border-width: 1px; border-radius: 10px;
        VerticalBox {
            padding: 12px; spacing: 10px;
            HorizontalBox {
                padding: 0px; spacing: 6px; height: 32px;
                Text { text: "Terminal"; color: #e3e7f3; font-size: 15px; font-weight: 600; horizontal-stretch: 1; }
                ComboBox { model: ["cmd", "PowerShell"]; current-index <=> root.terminal-shell-index; width: 130px; enabled: !root.terminal-running && !root.terminal-busy; }
                IconButton { width: 32px; height: 32px; icon: root.terminal-running ? @image-url("assets/stop.svg") : @image-url("assets/play.svg"); label: root.terminal-running ? "Cerrar esta sesión de terminal" : "Iniciar terminal"; enabled: !root.terminal-busy; clicked => { if root.terminal-running { root.close-terminal(); } else { if root.terminal-rows.length > 0 { root.close-terminal(); } root.start-terminal(); } } }
            }
            terminal-surface := Rectangle {
                background: #101822; clip: true; min-height: 80px; vertical-stretch: 1;
                FocusScope {
                    width: parent.width; height: parent.height;
                    key-pressed(event) => { if root.terminal-running { root.terminal-key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift); return accept; } return reject; }
                    for row[index] in root.terminal-rows : Rectangle {
                        x: 6px; y: 6px + index * 18px; height: 18px; width: parent.width - 12px;
                        for run in row.runs : Rectangle {
                            x: run.column * 7.2px; y: 0px; width: run.columns * 7.2px; height: 18px; background: run.bg;
                            Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: run.text; color: run.fg; font-family: "Consolas"; font-size: 12px; font-weight: run.bold ? 700 : 400; vertical-alignment: center; }
                        }
                    }
                    if root.terminal-cursor-visible : Rectangle { x: 6px + root.terminal-cursor-column * 7.2px; y: 6px + root.terminal-cursor-row * 18px; width: 2px; height: 17px; background: #c0b6ff; }
                    terminal-touch := TouchArea {
                        clicked => { parent.focus(); }
                        scroll-event(event) => { root.terminal-scroll(event.delta-y > 0px ? 3 : -3); return accept; }
                    }
                }
            }
            Text { text: root.terminal-status; color: #91a0bc; font-size: 11px; wrap: word-wrap; max-height: 56px; overflow: elide; }
        }
    }

    if root.execution-open : Rectangle {
        x: root.width - self.width - 14px; y: 58px; width: root.panel-width; height: root.height - 72px;
        background: #121d29; border-color: #384561; border-width: 1px; border-radius: 10px;
        VerticalBox {
            padding: 12px; spacing: 8px;
            Text { text: "Ejecución del proyecto"; color: #e3e7f3; font-size: 15px; font-weight: 600; }
            HorizontalBox {
                spacing: 4px;
                ComboBox { model: root.execution-names; current-index <=> root.execution-index; enabled: !root.execution-busy; horizontal-stretch: 1; min-width: 0px; }
                IconButton { width: 32px; height: 32px; icon: @image-url("assets/play.svg"); label: "Iniciar ejecución"; enabled: !root.execution-busy && root.execution-names.length > 0; clicked => { root.execution-action("start"); } }
                IconButton { width: 32px; height: 32px; icon: @image-url("assets/refresh.svg"); label: "Reiniciar ejecución"; enabled: !root.execution-busy && root.execution-names.length > 0; clicked => { root.execution-action("restart"); } }
                IconButton { width: 32px; height: 32px; icon: @image-url("assets/stop.svg"); label: "Detener ejecución"; enabled: !root.execution-busy && root.execution-run-ids.length > 0; clicked => { root.execution-action("stop"); } }
            }
            HorizontalBox {
                spacing: 4px;
                Button { text: "Detectar"; enabled: !root.execution-busy && root.git-project != ""; clicked => { root.detect-execution(); } }
                Button { text: "Configurar"; clicked => { root.execution-config-open = !root.execution-config-open; root.execution-android-open = false; } }
                Button { text: "Android"; clicked => { root.execution-android-open = !root.execution-android-open; root.execution-config-open = false; } }
            }
            if root.execution-config-open : VerticalBox {
                spacing: 4px;
                Text { text: "Array JSON: id, name, program, args, directory, env. Las variables pueden contener secretos; no se envían al agente al listar."; color: #91a0bc; font-size: 11px; wrap: word-wrap; }
                TextEdit { height: 180px; text <=> root.execution-config-json; }
                Button { text: "Guardar configuraciones"; enabled: !root.execution-busy; clicked => { root.save-execution(); } }
            }
            if root.execution-android-open : VerticalBox {
                spacing: 4px;
                Text { text: "Seleccioná arriba una tarea Gradle Android. Guardar crea tareas para la variante y el dispositivo; no las ejecuta."; color: #91a0bc; font-size: 11px; wrap: word-wrap; }
                LineEdit { text <=> root.execution-android-module; placeholder-text: "Módulo (app o feature:app)"; }
                LineEdit { text <=> root.execution-android-variant; placeholder-text: "Variante (Debug, DemoDebug…)"; }
                ComboBox { model: root.execution-device-names; current-index <=> root.execution-device-index; selected(value) => { root.choose-execution-device(); } }
                Button { text: "Actualizar dispositivos"; enabled: !root.execution-busy; clicked => { root.execution-devices(); } }
                LineEdit { text <=> root.execution-android-device; placeholder-text: "Serial de adb (vacío: selección automática)"; }
                LineEdit { text <=> root.execution-android-component; placeholder-text: "paquete/.MainActivity (para lanzar/detener app)"; }
                Button { text: "Guardar tareas Android"; enabled: !root.execution-busy; clicked => { root.save-android-execution(); } }
                Button { text: "Abrir Logcat"; clicked => { root.select-panel(7); } }
            }
            Text { text: "Ejecuciones compartidas con el agente"; color: #bcb4ff; font-size: 12px; }
            ComboBox { model: root.execution-run-names; current-index <=> root.execution-run-index; }
            CheckBox { text: "Mostrar stderr (stdout por defecto)"; checked <=> root.execution-stderr; }
            TextEdit { text: root.execution-output; read-only: true; vertical-stretch: 1; min-height: 60px; }
            Text { text: root.execution-message; color: #91a0bc; font-size: 11px; wrap: word-wrap; max-height: 70px; overflow: elide; }
        }
    }

    if root.search-open : Rectangle {
        x: root.width - self.width - 14px; y: 58px;
        width: root.panel-width; height: root.height - 72px;
        background: #121d29; border-color: #384561; border-width: 1px; border-radius: 10px;
        VerticalBox {
            padding: 12px; spacing: 10px;
            Text { text: "Buscar en el proyecto"; color: #e3e7f3; font-size: 15px; font-weight: 600; }
            LineEdit { text <=> root.search-query; placeholder-text: "Texto o nombre de archivo"; accepted => { root.run-search(); } }
            ComboBox { model: ["Archivos", "Contenido", "Archivos y contenido"]; current-index <=> root.search-mode; }
            Button { text: "Buscar"; clicked => { root.run-search(); } }
            ListView {
                horizontal-scrollbar-policy: always-off;
                for result in root.search-rows : Rectangle {
                    height: 70px; background: result-touch.has-hover ? #263246 : #1b2735;
                    Text { x: 8px; y: 6px; width: parent.width - 16px; height: 22px; text: result.path + (result.line > 0 ? ":" + result.line : ""); color: #bcb4ff; overflow: elide; font-size: 12px; }
                    Text { x: 8px; y: 30px; width: parent.width - 16px; height: 32px; text: result.text; color: #dde3ef; overflow: elide; font-size: 11px; }
                    result-touch := TouchArea { clicked => { root.open-problem-file(result.path, result.line); } }
                }
            }
            Text { text: root.search-status; color: #91a0bc; font-size: 11px; wrap: word-wrap; }
        }
    }
    if root.lint-open || root.lint-progress > 0 : Rectangle {
        x: root.width - self.width - 14px + (1 - root.lint-progress) * (self.width + 14px);
        y: 58px; width: root.panel-width; height: root.height - 72px;
        background: #121d29; border-color: #384561; border-width: 1px; border-radius: 10px;
        VerticalBox {
            padding: 12px; spacing: 10px;
            HorizontalBox {
                padding: 0px; spacing: 6px; height: 32px;
                Text { text: "Problemas"; color: #e3e7f3; font-size: 15px; font-weight: 600; horizontal-stretch: 1; }
                if root.lint-busy : Image { source: @image-url("assets/quota-spinner.svg"); width: 14px; height: 14px; transform-origin: { x: self.width / 2, y: self.height / 2 }; transform-rotation: 360deg * mod(animation-tick(), 900ms) / 900ms; }
                IconButton { width: 32px; height: 32px; icon: @image-url("assets/folder.svg"); label: "Ver logs del linter"; clicked => { root.open-lint-logs(); } }
                IconButton { width: 32px; height: 32px; icon: @image-url("assets/settings.svg"); label: "Configurar otro linter"; enabled: !root.lint-busy; clicked => { root.lint-config-open = !root.lint-config-open; } }
            }
            HorizontalBox {
                padding: 0px; spacing: 6px; height: 32px;
                ComboBox { model: root.lint-tools; current-index <=> root.lint-tool-index; enabled: !root.lint-busy; horizontal-stretch: 1; }
                IconButton { width: 32px; height: 32px; icon: root.lint-busy ? @image-url("assets/stop.svg") : @image-url("assets/play.svg"); label: root.lint-busy ? "Cancelar linter" : "Ejecutar linter"; enabled: root.lint-busy || root.lint-tools.length > 0; clicked => { if root.lint-busy { root.stop-lint(); } else { root.run-lint(); } } }
            }
            if root.lint-config-open : VerticalBox {
                padding: 0px; spacing: 6px;
                LineEdit { text <=> root.lint-name; placeholder-text: "Nombre"; }
                LineEdit { text <=> root.lint-program; placeholder-text: "Ejecutable (sin argumentos)"; }
                LineEdit { text <=> root.lint-args; placeholder-text: "Argumentos como array JSON"; }
                ComboBox { model: ["Texto archivo:línea:columna", "JSON del harness", "SARIF", "Checkstyle XML", "ESLint", "Clippy", "Ruff", "Android Lint XML", "PHPStan", "RuboCop", "SwiftLint", "Dart", "ShellCheck"]; current-index <=> root.lint-format-index; }
                CheckBox { text: "Leer archivos en build/reports"; checked <=> root.lint-report-files; }
                Text { text: root.lint-config-error; color: #efa3a3; wrap: word-wrap; }
                Button { text: "Guardar linter del proyecto"; clicked => { root.save-lint-config(); } }
            }
            HorizontalBox {
                padding: 0px; spacing: 6px; height: 32px;
                LineEdit { text <=> root.lint-filter; placeholder-text: "Filtrar archivo, regla o mensaje"; horizontal-stretch: 1; }
                ComboBox { model: ["Todos", "Errores", "Advertencias"]; current-index <=> root.lint-severity; width: 120px; }
            }
            ListView {
                horizontal-scrollbar-policy: always-off;
                for problem in root.lint-rows : Rectangle {
                    height: problem-card.height + 6px;
                    problem-card := Rectangle {
                        x: 0px; y: 0px; width: parent.width; height: problem-location.y + problem-location.height + 9px; background: problem-touch.has-hover ? #263246 : #1b2735; border-radius: 6px;
                        Rectangle { x: 0px; y: 7px; width: 3px; height: parent.height - 14px; background: problem.error ? #ef939f : #e3bd7b; border-radius: 2px; }
                        Text { x: 10px; y: 6px; width: parent.width - 20px; height: 19px; text: (problem.error ? "Error" : "Advertencia") + (problem.code == "" ? "" : " · " + problem.code); color: problem.error ? #ef939f : #e3bd7b; font-size: 11px; overflow: elide; }
                        problem-message := Text { x: 10px; y: 27px; width: parent.width - 20px; height: max(16px, self.preferred-height); text: problem.message; color: #dde3ef; font-size: 12px; wrap: word-wrap; overflow: elide; }
                        problem-location := Text { x: 10px; y: problem-message.y + problem-message.height + 6px; width: parent.width - 20px; height: 19px; text: problem.path + (problem.line > 0 ? ":" + problem.line + ":" + problem.column : ""); color: #91a0bc; font-size: 10px; overflow: elide; }
                        problem-touch := TouchArea { enabled: problem.path != ""; clicked => { root.open-problem-file(problem.path, problem.line); } }
                    }
                }
            }
            Text { text: root.lint-status; color: #91a0bc; font-size: 11px; wrap: word-wrap; max-height: 90px; overflow: elide; }
        }
    }

    if root.docker-open || root.docker-progress > 0 : Rectangle {
        x: root.width - self.width - 14px + (1 - root.docker-progress) * (self.width + 14px);
        y: 58px; width: root.panel-width; height: root.height - 72px;
        background: #121d29; border-color: #384561; border-width: 1px; border-radius: 10px;
        VerticalBox {
            padding: 12px; spacing: 10px;
            HorizontalBox {
                padding: 0px; spacing: 6px; height: 32px;
                Image { source: @image-url("assets/docker.svg"); width: 20px; height: 20px; }
                Text { text: "Docker"; color: #e3e7f3; font-size: 15px; font-weight: 600; horizontal-stretch: 1; }
                if root.docker-busy : Image { source: @image-url("assets/quota-spinner.svg"); width: 14px; height: 14px; transform-origin: { x: self.width / 2, y: self.height / 2 }; transform-rotation: 360deg * mod(animation-tick(), 900ms) / 900ms; }
                IconButton { width: 32px; height: 32px; icon: @image-url("assets/refresh.svg"); label: "Actualizar contenedores"; enabled: !root.docker-busy; clicked => { root.docker-logs-open = false; root.refresh-docker(); } }
            }
            if !root.docker-logs-open : Button { text: "Levantar servicios Compose"; enabled: root.docker-compose && !root.docker-busy; clicked => { root.docker-action("", "up"); } }
            if !root.docker-logs-open : ListView {
                horizontal-scrollbar-policy: always-off;
                for container in root.docker-rows : Rectangle {
                    height: 142px;
                    Rectangle { x: 0px; y: 0px; height: 136px; width: parent.width; background: #1b2735; border-radius: 7px; }
                    VerticalBox {
                        x: 10px; y: 7px; width: parent.width - 20px; height: 122px; padding: 0px; spacing: 4px;
                        Text { text: container.name; color: #e1e5f4; font-size: 13px; font-weight: 600; overflow: elide; }
                        Text { text: container.detail; color: #91a0bc; font-size: 11px; wrap: word-wrap; overflow: elide; }
                        Text { text: container.status; color: container.running ? #77c595 : #b9afd8; font-size: 11px; }
                        HorizontalBox {
                            padding: 0px; spacing: 5px; height: 30px;
                            IconButton { width: 30px; height: 30px; icon: @image-url("assets/play.svg"); label: "Iniciar contenedor"; enabled: !root.docker-busy && !container.running && !container.paused; clicked => { root.docker-action(container.id, "start"); } }
                            IconButton { width: 30px; height: 30px; icon: @image-url("assets/stop.svg"); label: "Detener contenedor"; enabled: !root.docker-busy && container.running; clicked => { root.docker-action(container.id, "stop"); } }
                            IconButton { width: 30px; height: 30px; icon: @image-url("assets/refresh.svg"); label: "Reiniciar contenedor"; enabled: !root.docker-busy && !container.paused; clicked => { root.docker-action(container.id, "restart"); } }
                            Rectangle { horizontal-stretch: 1; }
                            IconButton { width: 30px; height: 30px; icon: @image-url("assets/logcat.svg"); label: "Ver logs del contenedor"; enabled: !root.docker-busy; clicked => { root.docker-action(container.id, "logs"); } }
                        }
                    }
                }
            }
            if root.docker-logs-open : HorizontalBox {
                padding: 0px; spacing: 6px; height: 30px;
                IconButton { width: 30px; height: 30px; icon: @image-url("assets/chevron-left.svg"); label: "Volver a contenedores"; clicked => { root.docker-logs-open = false; } }
                Text { text: root.docker-log-title; color: #b8b0ef; font-size: 11px; horizontal-stretch: 1; overflow: elide; }
            }
            if root.docker-logs-open : docker-log-scroll := ScrollView {
                content-width: max(self.visible-width, 1400px);
                ListView {
                    width: docker-log-scroll.content-width; height: docker-log-scroll.visible-height;
                    horizontal-scrollbar-policy: always-off;
                    for line in root.docker-logs : Text { text: line.text; color: #c8d1e1; font-family: "Consolas"; font-size: 11px; height: 19px; overflow: elide; }
                }
            }
            Text { max-height: 92px; overflow: elide; text: root.docker-status; color: #91a0bc; font-size: 11px; wrap: word-wrap; }
        }
    }

    if root.database-open || root.database-progress > 0 : Rectangle {
        x: root.width - self.width - 14px + (1 - root.database-progress) * (self.width + 14px);
        y: 58px; width: root.panel-width; height: root.height - 72px;
        background: #121d29; border-color: #384561; border-width: 1px; border-radius: 10px;
        VerticalBox {
            padding: 12px; spacing: 10px;
            HorizontalBox {
                padding: 0px; spacing: 6px; height: 32px;
                Image { source: @image-url("assets/database.svg"); width: 20px; height: 20px; }
                Text { text: "Base de datos"; color: #e3e7f3; font-size: 15px; font-weight: 600; horizontal-stretch: 1; }
                if root.database-busy : Image {
                    source: @image-url("assets/quota-spinner.svg"); width: 14px; height: 14px;
                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                    transform-rotation: 360deg * mod(animation-tick(), 900ms) / 900ms;
                }
                IconButton { width: 32px; height: 32px; icon: @image-url("assets/refresh.svg"); label: "Actualizar diagrama"; enabled: !root.database-busy; clicked => { root.refresh-database(true); } }
            }
            if root.database-schemas.length > 1 : ComboBox {
                model: root.database-schemas; current-index <=> root.database-schema-index; enabled: !root.database-busy;
                selected => { root.database-schema = root.database-schemas[self.current-index]; root.refresh-database(false); }
            }
            HorizontalBox {
                padding: 0px; spacing: 6px; height: 32px;
                LineEdit { enabled: !root.database-busy; text <=> root.database-schema; placeholder-text: "Archivo .prisma o carpeta"; horizontal-stretch: 1; accepted => { root.refresh-database(false); } }
                IconButton { width: 32px; height: 32px; icon: @image-url("assets/folder.svg"); label: "Buscar esquema Prisma"; enabled: !root.database-busy; clicked => { root.browse-database-schema(); } }
            }
            HorizontalBox {
                padding: 0px; spacing: 4px; height: 28px;
                Button { text: "Diagrama"; enabled: root.database-relations-view; clicked => { root.database-relations-view = false; } }
                Button { text: "Relaciones"; enabled: !root.database-relations-view; clicked => { root.database-relations-view = true; } }
                Rectangle { horizontal-stretch: 1; }
            }
            if !root.database-relations-view : database-scroll := ScrollView {
                content-width: max(self.visible-width, root.database-width * root.database-zoom * 1px);
                content-height: max(self.visible-height, root.database-height * root.database-zoom * 1px);
                Rectangle {
                    width: database-scroll.content-width; height: database-scroll.content-height; background: #101822;
                    for edge in root.database-relations : Rectangle {
                        // Three orthogonal segments remain vector geometry at any zoom.
                        x: min(edge.x1, edge.mid) * root.database-zoom * 1px; y: edge.y1 * root.database-zoom * 1px;
                        width: max(2px, abs(edge.mid - edge.x1) * root.database-zoom * 1px); height: 1px; background: #8075c1;
                        Rectangle {
                            x: (edge.mid - min(edge.x1, edge.mid)) * root.database-zoom * 1px;
                            y: (min(edge.y1, edge.y2) - edge.y1) * root.database-zoom * 1px;
                            width: 1px; height: max(1px, abs(edge.y2 - edge.y1) * root.database-zoom * 1px); background: #8075c1;
                        }
                        Rectangle {
                            x: (min(edge.mid, edge.x2) - min(edge.x1, edge.mid)) * root.database-zoom * 1px;
                            y: (edge.y2 - edge.y1) * root.database-zoom * 1px;
                            width: max(2px, abs(edge.x2 - edge.mid) * root.database-zoom * 1px); height: 1px; background: #8075c1;
                        }
                        Rectangle { x: (edge.x1 - min(edge.x1, edge.mid)) * root.database-zoom * 1px - 2px; y: -2px; width: 5px; height: 5px; border-radius: 3px; background: #aaa2ff; }
                        Rectangle { x: (edge.x2 - min(edge.x1, edge.mid)) * root.database-zoom * 1px - 2px; y: (edge.y2 - edge.y1) * root.database-zoom * 1px - 2px; width: 5px; height: 5px; border-radius: 3px; background: #aaa2ff; }
                    }
                    for entity in root.database-entities : Rectangle {
                        x: entity.x * root.database-zoom * 1px; y: entity.y * root.database-zoom * 1px;
                        width: 260px * root.database-zoom; height: entity.height * root.database-zoom * 1px;
                        private property <bool> in-view: self.x + self.width >= -database-scroll.content-x && self.x <= -database-scroll.content-x + database-scroll.visible-width && self.y + self.height >= -database-scroll.content-y && self.y <= -database-scroll.content-y + database-scroll.visible-height;
                        if self.in-view : Rectangle {
                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                            background: #1c2836; border-color: #45536a; border-width: 1px; border-radius: 5px;
                            Rectangle { x: 0px; y: 0px; height: 40px * root.database-zoom; width: parent.width; background: #303353; border-radius: 5px; }
                            Text { x: 9px * root.database-zoom; y: 3px * root.database-zoom; width: parent.width - 18px * root.database-zoom; height: 20px * root.database-zoom; text: entity.name; color: #e9e4ff; font-size: 13px * root.database-zoom; font-weight: 600; overflow: elide; }
                            Text { x: 9px * root.database-zoom; y: 23px * root.database-zoom; width: parent.width - 18px * root.database-zoom; height: 14px * root.database-zoom; text: entity.detail; color: #aaa2c5; font-size: 10px * root.database-zoom; overflow: elide; }
                            for field[index] in entity.fields : Rectangle {
                                y: (40px + index * 22px) * root.database-zoom; height: 22px * root.database-zoom; width: parent.width;
                                private property <bool> field-visible: (entity.y + 40 + index * 22) * root.database-zoom * 1px + self.height >= -database-scroll.content-y && (entity.y + 40 + index * 22) * root.database-zoom * 1px <= -database-scroll.content-y + database-scroll.visible-height;
                                if self.field-visible : HorizontalBox {
                                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                                    padding-left: 8px * root.database-zoom; padding-right: 8px * root.database-zoom; padding-top: 0px; padding-bottom: 0px; spacing: 4px * root.database-zoom;
                                    Text { text: field.name; color: field.key ? #e9bf80 : #dfe4f3; font-size: 11px * root.database-zoom; overflow: elide; min-width: 0px; horizontal-stretch: 1; }
                                    Text { text: field.kind; color: #9db0c6; font-size: 10px * root.database-zoom; overflow: elide; max-width: 100px * root.database-zoom; }
                                    Text { text: field.tags; color: #b9afff; font-size: 9px * root.database-zoom; }
                                }
                            }
                        }
                    }
                }
            }
            if root.database-relations-view : ListView {
                horizontal-scrollbar-policy: always-off;
                for relation in root.database-relations : Rectangle {
                    height: 76px;
                    Rectangle { height: 70px; width: parent.width; background: #192534; border-radius: 6px; }
                    Text { x: 9px; y: 7px; width: parent.width - 18px; height: 30px; text: relation.label; color: #c6bcff; font-size: 11px; wrap: word-wrap; }
                    Text { x: 9px; y: 38px; width: parent.width - 18px; height: 28px; text: relation.detail; color: #9db0c6; font-size: 10px; wrap: word-wrap; }
                }
            }
            HorizontalBox {
                padding: 0px; spacing: 4px; height: 28px;
                IconButton { width: 28px; height: 28px; icon: @image-url("assets/minus.svg"); label: "Alejar diagrama"; enabled: root.database-zoom > 0.4; clicked => { root.database-zoom = max(0.4, root.database-zoom - 0.1); } }
                Text { text: round(root.database-zoom * 100) + "%"; color: #aebbd0; font-size: 11px; horizontal-stretch: 1; horizontal-alignment: center; }
                IconButton { width: 28px; height: 28px; icon: @image-url("assets/plus.svg"); label: "Acercar diagrama"; enabled: root.database-zoom < 1.6; clicked => { root.database-zoom = min(1.6, root.database-zoom + 0.1); } }
            }
            Text { max-height: 92px; overflow: elide; text: root.database-status; color: #91a0bc; font-size: 11px; wrap: word-wrap; }
        }
    }

    if root.projects-compact && root.projects-hover-title != "" : Rectangle {
        x: 94px; y: clamp(root.projects-hover-y, 58px, root.height - 42px);
        width: min(300px, tooltip-text.preferred-width + 24px); height: 34px;
        background: #253448; border-color: #6260d7; border-width: 1px; border-radius: 6px;
        tooltip-text := Text { x: 12px; width: parent.width - 24px; height: parent.height; text: root.projects-hover-title; color: #e3e7f3; font-size: 12px; overflow: elide; vertical-alignment: center; }
    }
    if !root.projects-compact : Rectangle {
        x: root.projects-width + 11px; y: 58px;
        width: 6px; height: projects-panel.height;
        projects-resize := TouchArea {
            private property <length> start-x;
            private property <length> start-width;
            mouse-cursor: ew-resize;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    self.start-x = parent.x + self.mouse-x;
                    self.start-width = root.projects-width;
                    root.projects-dragging = true;
                } else if event.kind == PointerEventKind.up { root.projects-dragging = false; }
            }
            changed pressed => { if !self.pressed { root.projects-dragging = false; } }
            moved => {
                if self.pressed {
                    root.projects-panel-width = clamp(self.start-width + parent.x + self.mouse-x - self.start-x, 260px, root.projects-max-width);
                }
            }
        }
    }

    if root.active-panel-index != 0 : Rectangle {
        x: root.width - root.panel-width - 17px; y: 58px;
        width: 6px; height: root.height - 72px;
        panel-resize := TouchArea {
            private property <length> start-x;
            private property <length> start-width;
            mouse-cursor: ew-resize;
            enabled: root.search-open || root.execution-open || max(max(root.http-progress, root.captures-progress), max(root.terminal-progress, max(root.lint-progress, max(root.docker-progress, max(root.database-progress, max(root.git-progress, max(root.files-progress, root.logcat-progress))))))) >= 0.99;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    self.start-x = parent.x + self.mouse-x;
                    self.start-width = root.panel-width;
                    root.panel-dragging = true;
                } else if event.kind == PointerEventKind.up { root.panel-dragging = false; }
            }
            changed pressed => { if !self.pressed { root.panel-dragging = false; } }
            moved => {
                if self.pressed {
                    root.side-panel-width = clamp(self.start-width + self.start-x - (parent.x + self.mouse-x), 280px, root.panel-max-width);
                }
            }
        }
    }

    if root.task-dialog-open : Rectangle {
        width: root.width; height: root.height; background: #080d18.with-alpha(0.87);
        TouchArea { }
        Rectangle {
            width: min(640px, root.width - 40px); height: min(640px, root.height - 40px);
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: #192534; border-radius: 12px; border-width: 1px; border-color: #6260d7;
            VerticalBox {
                padding: 20px; spacing: 10px;
                Text { text: root.task-edit-id == "" ? "Nueva tarea" : "Editar tarea"; color: #f0f2fa; font-size: 22px; height: 30px; }
                ScrollView {
                    content-width: self.visible-width; horizontal-scrollbar-policy: always-off;
                    VerticalBox {
                        padding: 0px; spacing: 8px;
                        Text { text: "Título"; color: #91a0bc; font-size: 12px; height: 18px; }
                        LineEdit { text <=> root.task-title; placeholder-text: "Título de la tarea"; height: 32px; }
                        Text { text: "Objetivo"; color: #91a0bc; font-size: 12px; height: 18px; }
                        TextEdit { text <=> root.task-objective; placeholder-text: "¿Qué queremos lograr?"; height: 110px; font-size: 13px; }
                        Text { text: "Criterio de aceptación"; color: #91a0bc; font-size: 12px; height: 18px; }
                        TextEdit { text <=> root.task-acceptance; placeholder-text: "¿Cómo verificamos que está realizada?"; height: 110px; font-size: 13px; }
                        HorizontalBox {
                            padding: 0px; spacing: 12px; height: 58px;
                            VerticalBox {
                                padding: 0px; spacing: 8px; horizontal-stretch: 1;
                                Text { text: "Severidad"; color: #91a0bc; font-size: 12px; height: 18px; }
                                ComboBox { model: ["Baja", "Media", "Alta", "Crítica"]; current-index <=> root.task-severity; height: 32px; min-width: 0px; max-width: 100000px; }
                            }
                            VerticalBox {
                                padding: 0px; spacing: 8px; horizontal-stretch: 1;
                                Text { text: "Columna"; color: #91a0bc; font-size: 12px; height: 18px; }
                                ComboBox { model: ["Por hacer", "En progreso", "Realizadas"]; current-index <=> root.task-status; height: 32px; min-width: 0px; max-width: 100000px; }
                            }
                        }
                        if root.task-edit-id != "" : Text { text: root.task-token-detail; color: #91a0bc; font-size: 12px; wrap: word-wrap; }
                        if root.task-error != "" : Text { text: root.task-error; color: #ed9696; font-size: 12px; wrap: word-wrap; }
                    }
                }
                HorizontalBox {
                    padding: 0px; spacing: 8px; height: 32px;
                    Button { text: "Cancelar"; clicked => { root.task-dialog-open = false; } }
                    Button { text: "Guardar"; enabled: root.task-title != "" && root.task-objective != "" && root.task-acceptance != ""; clicked => { root.save-task(); } }
                }
            }
        }
    }


    if root.flows-open && root.flow-preview-open : Rectangle {
        width: parent.width; height: parent.height; background: #080d16e8;
        TouchArea { clicked => { root.flow-preview-open = false; } }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(parent.width - 48px, 960px); height: parent.height - 80px;
            background: #172332; border-radius: 10px;
            TouchArea { }
            VerticalBox {
                padding: 16px; spacing: 10px;
                Text { text: "Guardar test: " + root.flow-export-target; color: #e3e7f3; font-size: 16px; overflow: elide; }
                Text { text: "Revisá selectores y verificaciones. Los valores fill requieren FLOW_VALUE_*. Se crea un archivo nuevo; no se sobrescriben tests ni se ejecuta código."; color: #91a0bc; wrap: word-wrap; }
                TextEdit { text: root.flow-code; read-only: true; vertical-stretch: 1; }
                HorizontalBox {
                    Button { text: "Cancelar"; clicked => { root.flow-preview-open = false; } }
                    Button { text: "Confirmar y guardar en el proyecto"; clicked => { root.save-flow-test(); } }
                }
            }
        }
    }

    if root.captures-open && root.capture-preview-open : Rectangle {
        width: parent.width; height: parent.height; background: #080d16e8;
        TouchArea { clicked => { root.capture-preview-open = false; } }
        Rectangle {
            x: 40px; y: 40px; width: parent.width - 80px; height: parent.height - 80px;
            background: #172332; border-radius: 10px;
            VerticalBox {
                padding: 12px; spacing: 8px;
                HorizontalBox {
                    height: 28px;
                    Text { text: root.captures-title; color: #e3e7f3; horizontal-stretch: 1; overflow: elide; }
                    Button { text: "Cerrar"; clicked => { root.capture-preview-open = false; } }
                }
                Image { source: root.captures-image; image-fit: contain; horizontal-stretch: 1; vertical-stretch: 1; }
            }
        }
    }
    if root.http-open && root.http-variables-open : Rectangle {
        width: root.width; height: root.height; background: #080d18.with-alpha(0.87);
        TouchArea { }
        Rectangle {
            width: min(580px, root.width - 40px); height: min(440px, root.height - 40px);
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: #192534; border-radius: 12px; border-width: 1px; border-color: #6260d7;
            VerticalBox {
                padding: 24px; spacing: 12px;
                Text { text: "Configuración HTTP del proyecto"; color: #e3e7f3; font-size: 20px; }
                Text { text: "Objeto JSON con valores de texto. Usá {{NOMBRE}} en URL, headers o body. Los valores se guardan fuera del repositorio y no se exponen a los agentes."; color: #91a0bc; font-size: 12px; wrap: word-wrap; }
                HorizontalBox {
                    height: 32px; padding: 0px; spacing: 8px;
                    Text { text: "Timeout del proyecto (segundos)"; color: #e3e7f3; vertical-alignment: center; horizontal-stretch: 1; }
                    SpinBox { width: 80px; height: 32px; minimum: 1; maximum: 120; value <=> root.http-timeout; accessible-label: "Timeout del proyecto en segundos"; }
                }
                TextEdit { text <=> root.http-variables-json; }
                Text { text: root.http-notice; color: #91a0bc; font-size: 11px; wrap: word-wrap; }
                HorizontalBox { padding: 0px; spacing: 8px;
                    Button { text: "Cancelar"; clicked => { root.http-variables-open = false; } }
                    Button { text: "Guardar configuración"; clicked => { root.http-action("save-variables"); } }
                }
            }
        }
    }
    if root.http-rename-open : Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height; background: #080d18.with-alpha(0.87);
        TouchArea { }
        Rectangle {
            width: min(420px, root.width - 40px); height: 180px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: #192534; border-radius: 12px; border-width: 1px; border-color: #6260d7;
            VerticalBox {
                padding: 20px; spacing: 10px;
                Text { text: root.http-rename-collection ? "Renombrar colección" : "Editar request"; color: #e3e7f3; font-size: 18px; }
                LineEdit { text <=> root.http-rename-name; placeholder-text: "Nombre"; accessible-label: "Nuevo nombre"; }
                Text { text: root.http-notice; color: #91a0bc; font-size: 11px; overflow: elide; }
                HorizontalBox {
                    padding: 0px; spacing: 8px;
                    if !root.http-rename-collection : IconButton { width: 28px; height: 28px; icon: @image-url("assets/minus.svg"); label: "Eliminar request"; enabled: !root.http-busy && root.http-request-id != ""; clicked => { root.http-action("delete"); } }
                    Button { text: "Cancelar"; clicked => { root.http-rename-open = false; } }
                    Button { text: "Guardar"; enabled: !root.http-busy; clicked => { root.http-action(root.http-rename-collection ? "rename-collection" : "rename-request"); } }
                }
            }
        }
    }
    if root.git-settings-open : Rectangle {
        width: root.width; height: root.height; background: #080d18.with-alpha(0.87);
        TouchArea { }
        Rectangle {
            width: min(520px, root.width - 40px); height: root.git-action-message == "" ? 420px : 492px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: #192534; border-radius: 12px; border-width: 1px; border-color: #6260d7;
            VerticalBox {
                padding: 24px; spacing: 12px;
                Text { text: "Configuración de Git"; color: #f0f2fa; font-size: 22px; }
                Text { text: "Nombre para los commits (user.name)"; color: #91a0bc; font-size: 12px; }
                LineEdit { text <=> root.git-user-name; placeholder-text: "Nombre del autor"; enabled: !root.git-busy; }
                Text { text: "Email para los commits (user.email)"; color: #91a0bc; font-size: 12px; }
                LineEdit { text <=> root.git-user-email; placeholder-text: "nombre@ejemplo.com"; enabled: !root.git-busy; }
                Text { text: "Se leen los valores efectivos de Git. Los cambios se guardan solo en este repositorio. Los campos vacíos conservan su configuración."; color: #91a0bc; font-size: 11px; wrap: word-wrap; }
                Text { text: "URL de origin"; color: #91a0bc; font-size: 12px; }
                LineEdit { text <=> root.git-remote-url; placeholder-text: "Opcional: https://… o git@…"; enabled: !root.git-busy; }
                if root.git-action-message != "" : ScrollView {
                    height: 72px; content-width: self.visible-width; horizontal-scrollbar-policy: always-off;
                    Text { text: root.git-action-message; color: #dfe4f3; wrap: word-wrap; font-size: 11px; }
                }
                HorizontalBox {
                    padding: 0px; spacing: 8px;
                    Button { text: "Cancelar"; enabled: !root.git-busy; clicked => { root.git-settings-open = false; } }
                    Button { text: "Guardar"; enabled: !root.git-busy && (root.git-user-name != "" || root.git-user-email != "" || root.git-remote-url != ""); clicked => { root.git-action("settings", ""); } }
                }
            }
        }
    }

    if root.project-dialog || root.project-progress > 0 : Rectangle {
        background: #080d18.with-alpha(root.project-progress * 0.87);
        TouchArea { }
        Rectangle {
            width: 520px;
            height: 290px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (1 - root.project-progress) * 8px;
            background: #192534;
            border-radius: 12px;
            border-width: 1px;
            border-color: #6260d7;
            VerticalBox {
                padding: 24px;
                spacing: 12px;
                Text { text: "Abrir proyecto"; color: #f0f2fa; font-size: 22px; }
                LineEdit { placeholder-text: "Nombre del proyecto"; text <=> root.project-name; }
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    LineEdit { placeholder-text: "Ruta de la carpeta"; text <=> root.new-path; horizontal-stretch: 1; }
                    Button {
                        text: "Buscar carpeta…";
                        enabled: !root.folder-picker-open;
                        clicked => { root.browse-folder(); }
                    }
                }
                Text { text: "Usamos el directorio existente. No se modifican sus archivos."; color: #91a0bc; wrap: word-wrap; font-size: 12px; }
                HorizontalBox {
                    Button { text: "Cancelar"; enabled: !root.folder-picker-open; clicked => { root.project-dialog = false; } }
                    Button { text: "Abrir"; enabled: !root.folder-picker-open && root.project-name != "" && root.new-path != ""; clicked => { root.add-project(root.project-name, root.new-path); root.project-dialog = false; } }
                }
            }
        }
    }

    if root.settings-open || root.settings-progress > 0 : Rectangle {
        width: root.width;
        height: root.height;
        background: #080d18.with-alpha(root.settings-progress * 0.87);
        TouchArea { }
        Rectangle {
            width: min(820px, root.width - 40px);
            height: min(660px, root.height - 40px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (1 - root.settings-progress) * 8px;
            background: #192534;
            border-radius: 12px;
            border-width: 1px;
            border-color: #6260d7;
            VerticalBox {
                padding: 20px;
                spacing: 12px;
                Text { text: "Proveedores de agentes"; color: #f0f2fa; font-size: 22px; }
                ScrollView {
                    content-width: self.visible-width;
                    horizontal-scrollbar-policy: always-off;
                    VerticalBox {
                        padding: 0px;
                        spacing: 12px;
                        AgentConfig {
                            name: "Codex";
                            direct: true;
                            connected: root.codex-authenticated;
                            models: root.codex-models;
                            model-index <=> root.codex-model-index;
                            pick-model(index) => { root.pick-codex-model(index); }
                            disconnect => { root.disconnect-codex(); }
                            enabled <=> root.codex-enabled;
                            executable <=> root.codex-path;
                            model <=> root.codex-model;
                            concurrency <=> root.codex-concurrency;
                            effort-index <=> root.codex-effort-index;
                            status: root.codex-status;
                            busy: root.settings-busy;
                            detect => { root.detect-agent(0); }
                            browse => { root.browse-agent(0); }
                            check => { root.check-agent(0, false); }
                            login => { root.check-agent(0, true); }
                            path-edited => { root.invalidate-agent(0); }
                        }
                        AgentConfig {
                            name: "Claude Code - Cliente oficial";
                            pending: false;
                            enabled <=> root.claude-enabled;
                            executable <=> root.claude-path;
                            model <=> root.claude-model;
                            concurrency <=> root.claude-concurrency;
                            status: root.claude-status;
                            busy: root.settings-busy;
                            detect => { root.detect-agent(1); }
                            browse => { root.browse-agent(1); }
                            check => { root.check-agent(1, false); }
                            login => { root.check-agent(1, true); }
                            path-edited => { root.invalidate-agent(1); }
                        }
                    }
                }
                Text { text: "Codex usa las herramientas del harness. Claude usa el cliente oficial y las herramientas del harness. Para limitar el consumo a tu plan, desactivá el uso de créditos para esta aplicación en ChatGPT Settings → Usage."; color: #c5badf; wrap: word-wrap; font-size: 12px; }
                Text { text: root.settings-notice; color: #a6b4cb; wrap: word-wrap; font-size: 12px; }
                if root.scroll-profile-status != "" : Text { text: root.scroll-profile-status; color: #91a0bc; font-size: 11px; wrap: word-wrap; max-height: 48px; overflow: elide; }
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    if root.settings-busy : Button { text: "Cancelar conexión"; clicked => { root.cancel-auth(); } }
                    Button { text: root.scroll-profiling ? "Detener medición" : "Medir scroll"; clicked => { root.toggle-scroll-profile(); } }
                    Button { text: "Cancelar"; enabled: !root.settings-busy; clicked => { root.close-settings(); } }
                    Button { text: "Guardar configuración"; enabled: !root.settings-busy; clicked => { root.save-settings(); } }
                }
            }
        }
    }
}
